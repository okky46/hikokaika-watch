# ============================================================
# 非公開化ウォッチ 環境変数
# ============================================================

# --- ビルド時(公開データの静的化に使用。サーバー/CIのみ。ブラウザへは出ない) ---
# ローカル開発用の既定値。Cloudflare Pages では必ず明示設定する。
DEPLOY_ENV=development
DATA_SOURCE=sample
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service Role Key はビルド環境(Cloudflare Pages のビルド環境変数)にのみ設定する。
# 絶対にブラウザへ公開しない(PUBLIC_ を付けない)。
SUPABASE_SERVICE_ROLE_KEY=

# --- クライアント(PUBLIC_ 付きはブラウザに埋め込まれる。anon key のみ許可) ---
# ログイン機能(お気に入り・メモ)に使用。未設定の場合ログイン機能は非表示になる。
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# --- サイトURL(canonical / OGP / sitemap 用) ---
SITE_URL=https://hikokaika-watch.pages.dev

# --- 追加掲載・訂正申請の Google フォーム URL ---
PUBLIC_REQUEST_FORM_URL=https://forms.gle/xxxxxxxxxxxx

# --- 広告・アクセス統計(PUBLIC_ 付きはHTMLへ出力されるため公開値のみ) ---
# Google AdSense の client ID。未設定なら広告タグは一切出力されない。
PUBLIC_ADSENSE_CLIENT=
# AdSense 管理画面で広告ユニットごとに発行されるID。配置名ではなく文字列のまま設定する。
PUBLIC_ADSENSE_SLOT_HOME=
PUBLIC_ADSENSE_SLOT_CASE_TIMELINE_1=
PUBLIC_ADSENSE_SLOT_CASE_TIMELINE_2=
# Cloudflare Web Analytics の公開トークン。未設定ならビーコンは出力されない。
PUBLIC_CF_ANALYTICS_TOKEN=

# --- Cloudflare Pages Function 用(サーバー側のみ。PUBLIC_ を付けない) ---
# /api/analytics が Cloudflare GraphQL Analytics API を呼び出すためのトークン。
CF_ANALYTICS_API_TOKEN=
# Cloudflare Analytics 対象ゾーンID(zoneTag)。
CF_ZONE_TAG=
# 必要に応じて運用メモ用に保持するCloudflareアカウントID。
CF_ACCOUNT_ID=

# --- GitHub Actions: 平日終値取得用 GitHub Secrets ---
# GitHub リポジトリの Settings → Secrets and variables → Actions に設定する。
# Service Role Key は Actions のみで使用し、ログやPUBLIC_変数には絶対に入れない。
CLOUDFLARE_DEPLOY_HOOK_URL=

# Phase 5 collection pipeline (GitHub Actions / local dry-run)
DISCORD_WEBHOOK_URL=
EDINET_API_KEY=
TDNET_API_BASE_URL=https://webapi.yanoshin.jp/webapi/tdnet/list
ADMIN_URL=https://example.com/admin/
# TDnet: base URL by default; collector builds /YYYYmmdd.json2?limit=TDNET_API_LIMIT.
TDNET_API_FORMAT=json2
TDNET_API_LIMIT=300
# EDINET API v2 official host. Subscription-Key is sent from EDINET_API_KEY.
EDINET_API_BASE_URL=https://api.edinet-fsa.go.jp/api/v2
# Public browser-safe EDINET viewer entry stored in inbox URLs.
EDINET_VIEWER_URL=https://disclosure2.edinet-fsa.go.jp/
