# ============================================================
# 非公開化ウォッチ 環境変数
# ============================================================

# --- ビルド時(公開データの静的化に使用。サーバー/CIのみ。ブラウザへは出ない) ---
# 未設定の場合は data/sample/ のサンプルデータでビルドされる。
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service Role Key はビルド環境(Cloudflare Pages のビルド環境変数)にのみ設定する。
# 絶対にブラウザへ公開しない(PUBLIC_ を付けない)。
SUPABASE_SERVICE_ROLE_KEY=

# --- クライアント(PUBLIC_ 付きはブラウザに埋め込まれる。anon key のみ許可) ---
# ログイン機能(お気に入り・メモ)に使用。未設定の場合ログイン機能は非表示になる。
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# --- サイトURL(canonical / OGP / sitemap 用) ---
SITE_URL=https://hikokaika-watch.pages.dev

# --- 追加掲載・訂正申請の Google フォーム URL ---
PUBLIC_REQUEST_FORM_URL=https://forms.gle/xxxxxxxxxxxx
