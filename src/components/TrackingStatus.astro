---
import { TRACKING_STATUS } from '../lib/trackingProfile';
import type { TrackingProfile } from '../lib/trackingProfile';
interface Props { profile: TrackingProfile | null }
const {profile}=Astro.props;
const status=profile ? TRACKING_STATUS[profile.public_status] : null;
---
<span class={`badge badge--${status?.tone ?? 'pause'}`}>{status?.label ?? '状況を確認中'}</span>
{profile?.status_note && <p class="status-note small">{profile.status_note}</p>}
