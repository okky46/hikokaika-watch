---
import StatusBadge from './StatusBadge.astro';
import StockLinks from './StockLinks.astro';
import { formatDate, reportYear } from '../lib/format';
import { isAcknowledgedCase } from '../lib/caseFilters';
import type { CaseListItem } from '../lib/types';
interface Props { cases: CaseListItem[]; section: 'pre' | 'post' }
const { cases, section } = Astro.props;
---
<div class="table-wrap">
  <table class="case-table tracking-table" id={`case-table-${section}`}>
    <thead><tr><th scope="col">銘柄</th><th scope="col">追跡のきっかけ</th><th scope="col">現在の状況</th><th scope="col">最新の出来事・確認</th><th scope="col"><span class="visually-hidden">お気に入り</span>★</th></tr></thead>
    <tbody>{cases.map(c => <tr data-case-id={c.id} data-name={`${c.companyName} ${c.title} ${c.trackingReason}`} data-code={c.securityCode} data-status={c.effectiveStatus} data-sources={c.sourceNames.join('|')} data-year={String(reportYear(c.firstReportedAt) ?? '')} data-formal={c.hasFormalAnnouncement ? '1' : '0'} data-acknowledged={isAcknowledgedCase(c) ? '1' : '0'}>
      <td data-label="銘柄"><span class="mono small muted">{c.securityCode}</span><br/><a class="case-link" href={`/cases/${c.slug}/`}>{c.companyName}</a><StockLinks code={c.securityCode}/></td>
      <td data-label="追跡のきっかけ"><p>{c.trackingReason || '追跡理由は未整理です。詳細の確認済み情報をご覧ください。'}</p><span class="small muted">追跡開始: {formatDate(c.trackingStartedOn)}</span></td>
      <td data-label="現在の状況"><StatusBadge status={c.effectiveStatus}/><p class="small muted">{c.verificationNote || (c.hasFormalAnnouncement ? '正式発表と、その後の成立・撤回等を記録します。' : '掲載は非公開化の決定・実現を示すものではありません。')}</p></td>
      <td data-label="最新の出来事・確認">{c.latestEvent ? <><span class="small muted">{c.latestEvent.dateLabel}</span><p><a href={`/cases/${c.slug}/#event-${c.latestEvent.id}`}>{c.latestEvent.title}</a></p></> : <p class="muted">公開済みの出来事はありません</p>}<span class="small muted">最終確認: {formatDate(c.lastCheckedOn)}</span></td>
      <td class="fav-cell cell-fav"><button type="button" class="fav-toggle" data-fav-toggle={c.id} aria-pressed="false" aria-label={`${c.companyName}をお気に入りに登録`} title="お気に入り(ログインが必要です)">☆</button></td>
    </tr>)}</tbody>
  </table>
  <p class="empty-state" id={`empty-state-${section}`} hidden>条件に一致する銘柄はありません。</p>
</div>
