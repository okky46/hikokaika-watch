---
import {METRICS,basisLabel} from '../lib/valuation';
import {comparableStats} from '../lib/comparableStats';
import type {Comparable} from '../lib/valuation';
interface Props {records:Comparable[];industry:string;excludeCode?:string;calculator?:boolean}
const {records,industry,excludeCode,calculator}=Astro.props;
const groups=comparableStats(records,industry,{excludeCode});
const fmt=(n:number)=>n.toLocaleString('ja-JP',{maximumFractionDigits:2});
---
<div class="section">
  <h3>{industry}の取引倍率</h3>
  <p class="small">成立・完了した案件の最終価格を使います。実績・会社予想、連結・単体、計算定義を分けて集計します。算定機関の評価レンジは含めません。</p>
  {groups.length?groups.map(g=><div class="card section"><p><strong>{METRICS[g.metric]} ／ {basisLabel(g.basis)} ／ {g.scope==='consolidated'?'連結':'単体'} ／ {g.count}件</strong></p><p>平均 {fmt(g.mean)}倍 ／ 中央値 {fmt(g.median)}倍 ／ 最小 {fmt(g.min)}倍〜最大 {fmt(g.max)}倍</p><p class="small">{g.definition}</p>
    {calculator&&<div class="stock-links">{[['平均',g.mean],['中央値',g.median]].map(([label,value])=><button class="btn" type="button" data-peer-metric={g.metric} data-peer-value={value} data-peer-name={`${industry}・${basisLabel(g.basis)}・${g.count}件の${label}`} data-peer-basis={g.basis} data-peer-scope={g.scope}>この{label}で試算</button>)}</div>}
    <details><summary>集計した{g.count}案件を見る</summary><ul>{g.samples.map(c=><li><a href={`/tob-comparables/#deal-${c.research!.dealId}`}>{c.name}（{c.code}）</a> ／ {c.announcedOn} ／ {fmt(c.multiples[g.metric]!.value)}倍</li>)}</ul></details>
  </div>):<p class="empty-state">条件が揃う公開済み取引倍率はまだありません。</p>}
</div>
