---
import {METRICS,basisLabel,prerequisites} from '../lib/valuation';
import type {Financials,Comparable,Metric} from '../lib/valuation';
import {comparableStats} from '../lib/comparableStats';
import {comparableAnchor} from '../lib/comparableAnchor';
import {matchingReferences,referencePeriod,referenceScenarios} from '../lib/valuationReference';
interface Props {financials?:Financials;comparables:Comparable[];industry:string}
const {financials,comparables,industry}=Astro.props;
const facts=financials?.facts??{};
const groups=comparableStats(comparables,industry,{excludeCode:financials?.code});
const multiple=(n:number)=>n.toLocaleString('ja-JP',{minimumFractionDigits:1,maximumFractionDigits:1});
const price=(n:number|null)=>n===null?'試算できません':`${n.toLocaleString('ja-JP',{maximumFractionDigits:0})}円`;
---
<section class="reference-section" aria-label="同業事例の参考倍率と試算株価">
  <h3>同業事例の参考倍率と試算株価</h3>
  <p class="small">{industry}の成立・完了したTOBの最終価格から集計しています。{financials?'「この倍率で試算する」を押すと、表示中の財務数値を使って試算できます。':'この銘柄の財務数値が登録されると、参考倍率を使って試算できます。'}</p>
  <p class="small">EV/EBITDAは事業価値の比較に使います。PER・PBRは利益・純資産との補助比較です。倍率を当てはめた株価は、第三者機関の評価額とは区別して参照してください。</p>
  <div class="reference-grid">
    {(['evEbitda','per','pbr'] as Metric[]).map(metric=>{
      const matches=matchingReferences(groups,metric,facts);
      return <article class="card reference-card" data-reference-metric={metric} data-metric-kind={metric}>
        <header class="reference-heading"><h4>{METRICS[metric]}</h4><span class="small">{metric==='evEbitda'?'事業価値で比較':metric==='per'?'利益で比較':'純資産で比較'}</span></header>
        {matches.length?matches.map(g=>{
          const scenarios=referenceScenarios(facts,metric,g.mean);
          const reason=prerequisites(facts,metric);
          return <div class="reference-group">
            <p class="small reference-context">{basisLabel(g.basis)}・{g.scope==='consolidated'?'連結':'単体'} ／ 対象{g.count}件<br/>TOB公表年月：{referencePeriod(g)}</p>
            <p class="small muted">{g.definition}</p>
            <dl class="reference-summary"><div><dt>{g.count===1?'参考事例1件の倍率：':'平均'}</dt><dd>{multiple(g.mean)}倍</dd></div><div><dt>参考株価</dt><dd class:list={['reference-price',{'reference-unavailable':scenarios[1].price===null}]} data-reference-center>{price(scenarios[1].price)}</dd></div></dl>
            <p class="small muted reference-calculation">{scenarios[1].price===null?'試算に必要な財務数値や条件をご確認ください。':`${g.count===1?'この事例の倍率':'平均倍率'}を、この銘柄の財務数値に当てはめた試算です。`}{g.count>1&&<> 中央値 {multiple(g.median)}倍</>}</p>
            {financials&&<button type="button" class="btn reference-use" data-use-reference data-use-metric={metric} data-reference-multiple={String(g.mean)} data-reference-label={`${METRICS[metric]}・${g.count===1?'参考事例1件':'平均（'+g.count+'件）'}・${basisLabel(g.basis)}・${g.scope==='consolidated'?'連結':'単体'} ／ ${g.definition}`} disabled={!!reason||scenarios[1].price===null}><span>この倍率で試算する</span><span aria-hidden="true">→</span></button>}
            <details class="reference-sensitivity"><summary>倍率を±10%変えて試算する</summary>
            <p class="small muted">倍率を変えた場合の計算例です。過去事例の分布や将来の予測幅を示すものではありません。</p>
            <div class="reference-range" aria-label="参考倍率の前後10パーセントによる試算">
              <div><span>−10%</span><strong>{multiple(scenarios[0].multiple)}倍</strong><span>{price(scenarios[0].price)}</span></div>
              <div class="reference-range-center"><span>中心</span><strong>{multiple(scenarios[1].multiple)}倍</strong><span>{price(scenarios[1].price)}</span></div>
              <div><span>＋10%</span><strong>{multiple(scenarios[2].multiple)}倍</strong><span>{price(scenarios[2].price)}</span></div>
            </div>
            </details>
            {reason&&<p class="small">{reason}</p>}
            {!reason&&scenarios.some(s=>s.price===null)&&<p class="small">正の株価にならない条件は試算できません。</p>}
            <details class="reference-sources"><summary>集計した{g.count}案件</summary><ul>{g.samples.map(c=><li><a href={`/tob-comparables/#${comparableAnchor(c)}`}>{c.name}（{c.code}）</a> ／ {c.announcedOn} ／ {multiple(c.multiples[metric]!.value)}倍</li>)}</ul></details>
          </div>;
        }):<><p class="reference-price muted">参考値なし</p><p class="small">この銘柄と比較条件がそろう取引倍率は未登録です。財務数値と対象事例の条件をご確認ください。</p></>}
      </article>;
    })}
  </div>
  <p class="small muted">表示倍率は小数1桁に丸めていますが、株価の計算と試算欄への反映には丸める前の倍率を使います。対象年月には各TOBの公表月を使います。</p>
</section>
<style>
.reference-section{margin:1.5rem 0}
.reference-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
.reference-card{min-width:0;padding:1.1rem;border-top:4px solid var(--metric-accent)}
.reference-heading{padding:.75rem;border-radius:var(--radius);background:var(--metric-bg);color:var(--metric-accent)}
.reference-heading h4{font-size:1.5rem;line-height:1.3;margin:0 0 .3rem}
.reference-group+.reference-group{border-top:1px solid var(--color-line);margin-top:1rem;padding-top:1rem}
.reference-context{min-height:3em}
.reference-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:1rem 0 .5rem;padding:.85rem .65rem;background:var(--metric-bg);border:1px solid var(--metric-line);border-radius:var(--radius)}
.reference-summary>div{min-width:0;display:flex;flex-direction:column;justify-content:space-between}
.reference-summary>div+div{border-left:1px solid var(--metric-line);padding-left:.65rem}
.reference-summary dt{font-size:.8rem;color:var(--color-ink-soft)}
.reference-summary dd,.reference-price{margin:.35rem 0 0;font-size:1.5rem;font-weight:700;line-height:1.3;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.reference-summary .reference-unavailable{font-size:1rem}
.reference-calculation{margin:.5rem 0 1rem}
.reference-card .reference-use{display:flex;justify-content:space-between;gap:.5rem;width:100%;min-height:44px;background:var(--metric-accent);border-color:var(--metric-accent);color:white;white-space:normal}
.reference-use:hover{filter:brightness(.9)}
.reference-use:disabled{opacity:.65;cursor:not-allowed}
.reference-sensitivity{margin-top:1rem}
.reference-sensitivity summary,.reference-sources summary{min-height:44px;display:list-item;padding:.6rem 0}
.reference-range{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid var(--metric-line);border-radius:var(--radius);overflow:hidden}
.reference-range>div{display:flex;flex-direction:column;gap:.25rem;align-items:center;text-align:center;padding:.7rem .25rem;font-size:.8rem}
.reference-range>div+div{border-left:1px solid var(--metric-line)}
.reference-range-center{background:var(--metric-bg)}
.reference-range strong{font-size:.95rem}
.reference-sources{border-top:1px solid var(--color-line);margin-top:.25rem}
.reference-sources ul{padding-left:1.1rem}
.reference-card p,.reference-card li{overflow-wrap:anywhere}
@media(max-width:1000px){.reference-grid{grid-template-columns:1fr}.reference-context{min-height:0}}
</style>
