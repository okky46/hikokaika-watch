---
/**
 * Google AdSense 広告枠。
 * PUBLIC_ADSENSE_CLIENT が未設定なら広告関連タグを一切出力しない。
 * 通常コンテンツとの誤認を防ぐため「広告」ラベルを必ず表示する。
 */
interface Props {
  /** Internal placement name used for layout and reporting. */
  placement: string;
  /** AdSense-issued ad unit ID.  Keep this as a string; do not coerce it. */
  slotId: string;
}

const { placement, slotId } = Astro.props;
const adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? '';
const isDev = import.meta.env.DEV;
---

{adClient && slotId && (
  <aside class="ad-slot" data-ad-placement={placement} aria-label="広告">
    <p class="ad-slot__label">広告</p>
    {isDev ? (
      <div class="ad-slot__placeholder">AdSense slot: {placement}</div>
    ) : (
      <>
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={adClient}
          data-ad-slot={slotId}
          data-ad-format="auto"
          data-full-width-responsive="true"
        ></ins>
        <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </>
    )}
  </aside>
)}
