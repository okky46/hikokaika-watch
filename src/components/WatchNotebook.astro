---
interface Props {caseId:string}
const {caseId}=Astro.props;
---
<aside class="watch-notebook card" id="note-section" data-notebook={caseId} aria-label="自分のメモ">
  <div class="workspace-heading"><h2>メモ</h2><button type="button" class="btn" data-follow disabled>お気に入りに追加</button></div>
  <p class="small muted" data-personal-scope>保存先を確認しています。</p>
  <details class="note-updates" id="watch-review">
    <summary class="btn small">前回からの更新</summary>
    <div class="note-updates__content small">
      <p data-watch-message aria-live="polite" hidden></p>
      <div data-watch-change-links class="watch-links" aria-label="更新箇所へのリンク"></div>
      <button type="button" class="btn small" data-watch-mark>確認済みにする</button>
      <p class="muted">確認状態はこのブラウザーに保存します。</p>
    </div>
  </details>
  <details class="note-entry" open><summary>メモを編集</summary>
  <form data-notebook-form>
    <label>見立て<input name="scenario" type="text" maxlength="1000" disabled/></label>
    <label>メモ・次の確認事項<textarea name="freeText" rows="4" maxlength="1000" disabled></textarea></label>
    <label>次回確認日<input name="nextCheckDate" type="date" disabled/></label>
    <details><summary>目標価格・見直し条件</summary><label>目標価格<input name="targetPrice" type="text" maxlength="1000" disabled/></label><label>見立てを見直す条件<input name="exitCondition" type="text" maxlength="1000" disabled/></label></details>
    <p class="small muted">メモを保存すると、お気に入りにも追加します。</p>
    <button type="submit" class="btn btn--primary" disabled>メモを保存</button>
  </form>
  </details>
  <p class="small" data-notebook-status role="status"></p>
  <a class="small" href="/mypage/#my-watch">マイページ →</a>
</aside>
