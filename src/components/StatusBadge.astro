---
import { statusDef } from '../lib/status';
import type { CaseStatus } from '../lib/types';

interface Props {
  status: CaseStatus;
}

const def = statusDef(Astro.props.status);
---

<span class={`badge badge--${def.tone}`} title={def.description}>
  <span class="badge__mark" aria-hidden="true">{def.mark}</span>{def.label}
</span>
