---
import EventTypeBadge from './EventTypeBadge.astro';
import {formatDateTime} from '../lib/format';
import type {CaseEventView} from '../lib/types';
interface Props {event:CaseEventView}
const {event}=Astro.props;
---
            <article class="event-card">
              <div class="event-card__head">
                <EventTypeBadge type={event.eventType} />
                <span class="event-card__date">{event.dateLabel}</span>
                {event.date.precision==='issue' && <span class="small muted">号数のみ確認・公表日は未確認{event.date.referenceMonth && `（参考年月：${event.date.referenceMonth}）`}</span>}
                {event.corrected && (
                  <span class="badge badge--stop"><span class="badge__mark" aria-hidden="true">!</span>訂正あり</span>
                )}
              </div>
              <h3 class="event-card__title">{event.title}</h3>
              {event.summary && <p class="event-card__summary">{event.summary}</p>}
              {event.largeShareholding && (
                <p class="event-card__summary"><strong>{event.largeShareholding.holderName}</strong> — <strong>保有 {event.largeShareholding.ratio.toFixed(2)}%</strong>{event.largeShareholding.previousRatio !== null && ` (前回 ${event.largeShareholding.previousRatio.toFixed(2)}%)`}</p>
              )}
              {event.corrected && event.correctionNote && (
                <p class="event-card__summary" style="color:var(--tone-stop-fg)">訂正: {event.correctionNote}</p>
              )}
              <div class="event-card__meta">
                <span>出典: {event.sourceUrl ? (
                  <a href={event.sourceUrl} target="_blank" rel="noopener noreferrer nofollow">{event.sourceName || '元情報'}</a>
                ) : (
                  event.sourceName || '—'
                )}</span>
                <span>本サイト初回掲載: {formatDateTime(event.sitePublishedAt)}</span>
                {event.updatedAt !== event.sitePublishedAt && <span>最終修正: {formatDateTime(event.updatedAt)}</span>}
              </div>
            </article>