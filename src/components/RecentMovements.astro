---
import type { CaseDetail } from '../lib/types';
import { recentMovements } from '../lib/recentMovements';
import { eventTypeDef } from '../lib/status';
interface Props { cases: CaseDetail[]; generatedAt: string }
const { asOf, items } = recentMovements(Astro.props.cases, new Date(Astro.props.generatedAt));
const href = (slug:string,id:string)=>`/cases/${encodeURIComponent(slug)}/#event-${encodeURIComponent(id)}`;
---
<section class="recent-movements" data-recent-movements aria-labelledby="recent-movements-title">
  <header class="recent-movements__head">
    <div><h2 id="recent-movements-title">最近の動き</h2><p class="small muted"><time datetime={asOf}>{asOf.replaceAll('-', '/')}</time>時点 · 直近30日の公表</p></div>
    <button type="button" class="recent-movements__pause" data-recent-pause aria-pressed="false" hidden>動きを止める</button>
  </header>
  {items.length ? <>
    <div class="recent-ticker" aria-live="off">
      {items.map(({slug,companyName,securityCode,event},i)=><a class="recent-ticker__item" data-recent-item hidden={i!==0} href={href(slug,event.id)}>
        <time datetime={event.date.start!}>{event.date.start!.replaceAll('-', '/')}</time>
        <span class="recent-ticker__body"><span class="recent-ticker__company"><strong>{companyName}</strong><span class="small muted">{securityCode}</span><span class="recent-ticker__kind">{eventTypeDef(event.eventType).label}{event.corrected&&'・訂正あり'}</span></span><span class="recent-ticker__title">{event.title}</span></span>
        <span aria-hidden="true">→</span>
      </a>)}
    </div>
    <div class="recent-movements__position small muted" data-recent-position aria-hidden="true">1 / {items.length}</div>
    <details class="recent-movements__details">
      <summary title="直近の動き"><span class="recent-movements__expand"><span aria-hidden="true">＋</span><span class="sr-only">直近{items.length}件を表示</span></span><span class="recent-movements__collapse"><span aria-hidden="true">−</span><span class="sr-only">閉じる</span></span></summary>
      <ol class="recent-movements__list">{items.map(({slug,companyName,securityCode,event})=><li><a class="recent-movement" href={href(slug,event.id)}>
        <span class="recent-movement__meta"><time datetime={event.date.start!}>{event.date.start!.replaceAll('-', '/')}</time><span>{eventTypeDef(event.eventType).label}{event.corrected&&'・訂正あり'}</span></span>
        <span><span class="recent-movement__company"><strong>{companyName}</strong><span class="small muted">{securityCode}</span><span aria-hidden="true">→</span></span><span class="recent-movement__title">{event.title}</span></span>
      </a></li>)}</ol>
    </details>
  </> : <p class="small muted recent-movements__empty">直近30日に公表された出来事は、まだ掲載されていません。</p>}
</section>
<script>
import {setupRecentTicker} from '../lib/recentTicker';
document.querySelectorAll<HTMLElement>('[data-recent-movements]').forEach(setupRecentTicker);
</script>
<style>
.recent-movements{position:relative;margin:.6rem 0;border:1px solid var(--color-line);border-radius:var(--radius);background:var(--color-surface);padding:.55rem .75rem}
.recent-movements__head{display:flex;align-items:center;justify-content:space-between;gap:.5rem;margin-bottom:.2rem;padding-right:3rem;min-height:44px}
h2{font-size:1rem;margin:0}.recent-movements__head p{margin:.2rem 0 0;font-size:.75rem}
.recent-movements__pause{flex:none;background:transparent;border:1px solid var(--color-line);border-radius:4px;padding:.3rem .55rem;min-height:44px;color:var(--color-ink-soft);font-size:.75rem;cursor:pointer}
.recent-movements__pause[hidden],.recent-ticker__item[hidden]{display:none!important}
.recent-ticker{overflow:hidden;min-height:3.6rem}
.recent-ticker__item{display:grid;grid-template-columns:6.2rem minmax(0,1fr) auto;align-items:center;gap:.6rem;min-height:3.6rem;color:var(--color-ink);text-decoration:none;padding:.25rem .1rem}
.recent-ticker__item:visited,.recent-movement:visited{color:var(--color-ink)}
.recent-ticker__item>time{font-size:.8rem;color:var(--color-ink-soft)}
.recent-ticker__body{position:relative;border-left:2px solid #b9cbdc;padding-left:1rem;min-width:0}
.recent-ticker__body::before{content:'';position:absolute;width:.5rem;height:.5rem;border-radius:50%;background:var(--color-primary);left:-.32rem;top:.4rem}
.recent-ticker__company,.recent-movement__company{display:flex;align-items:baseline;flex-wrap:wrap;gap:.3rem .6rem}
.recent-ticker__kind{font-size:.75rem;color:var(--color-ink-soft)}
.recent-ticker__title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:.88rem;margin-top:.25rem}
.recent-ticker__item--enter{animation:recent-arrive .45s ease-out}
@keyframes recent-arrive{from{opacity:0;transform:translateY(1rem)}to{opacity:1;transform:translateY(0)}}
.recent-movements__position{position:absolute;right:.85rem;bottom:.55rem;font-size:.7rem;pointer-events:none}
.recent-movements:has(details[open]) .recent-movements__position,.recent-movements:has(details[open]) .recent-ticker{display:none}
.recent-movements__details>summary{position:absolute;right:.6rem;top:.55rem;width:44px;height:44px;display:flex;align-items:center;justify-content:center;cursor:pointer;list-style:none;color:var(--color-ink-soft);font-size:1.2rem;border:1px solid var(--color-line);border-radius:4px}
.recent-movements__details>summary::-webkit-details-marker{display:none}
.recent-movements__collapse,.recent-movements__details[open] .recent-movements__expand{display:none}
.recent-movements__details[open] .recent-movements__collapse{display:inline}
.recent-movements__list{list-style:none;margin:.6rem 0 0;padding:0 0 0 .5rem}
.recent-movements__list li{position:relative;border-left:2px solid #dce5ed;padding:0 0 .7rem 1rem}
.recent-movements__list li:last-child{padding-bottom:0}
.recent-movements__list li::before{content:'';position:absolute;width:.4rem;height:.4rem;border-radius:50%;background:var(--color-primary);left:-.27rem;top:1rem}
.recent-movement{display:grid;grid-template-columns:10rem minmax(0,1fr);gap:.8rem;color:var(--color-ink);text-decoration:none;overflow-wrap:anywhere;padding:.65rem .5rem;border-radius:4px}
.recent-movement:hover,.recent-ticker__item:hover{background:#f6f8fb}
.recent-movement:focus-visible,.recent-ticker__item:focus-visible,summary:focus-visible,button:focus-visible{outline:2px solid var(--color-focus);outline-offset:-2px}
.recent-movement__meta{display:flex;flex-direction:column;gap:.2rem;color:var(--color-ink-soft);font-size:.75rem}
.recent-movement__title{display:block;margin-top:.25rem;font-size:.85rem}
.recent-movements__empty{margin:.65rem 0 .1rem}
@media(max-width:760px){.recent-ticker__item{grid-template-columns:4.7rem minmax(0,1fr) auto;gap:.4rem;min-height:4.5rem;padding-bottom:1rem}.recent-ticker{min-height:4.5rem}.recent-ticker__item>time{font-size:.7rem;white-space:nowrap}.recent-ticker__body{padding-left:.6rem}.recent-ticker__company{gap:.15rem .35rem}.recent-ticker__kind{font-size:.7rem}.recent-ticker__title{margin-top:.1rem;font-size:.8rem}.recent-movement{grid-template-columns:1fr;gap:.35rem}.recent-movement__meta{flex-direction:row;flex-wrap:wrap;gap:.3rem .6rem}}
@media(prefers-reduced-motion:reduce){.recent-ticker__item--enter{animation:none}}
</style>
