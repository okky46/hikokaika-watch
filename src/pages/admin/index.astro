      const raw = item.raw ?? {};
      const checked = selectedInboxIds.has(item.id) ? ' checked' : '';
      return `<article class="card" style="margin-bottom:0.7rem">
        <div class="event-card__head">
          <label class="small"><input type="checkbox" data-inbox-select="${esc(item.id)}"${checked} /> 選択</label>
