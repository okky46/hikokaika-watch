  // ---------------- 案件 ----------------
  async function loadCases() {
    const { data, error } = await supabase!
      .from('cases')
      .select('*')
      .order('updated_at', { ascending: false });
    if (error) $('ca-status-msg').textContent = '読み込めませんでした。通信状況と管理者のログイン状態を確認してから、再読み込みしてください。';
    cases = data ?? [];
    const editions = await supabase!.from('tracking_editions').select('*');
    if(editions.error)throw new Error(`分類の読込エラー: ${editions.error.message}`);
    trackingEditions=editions.data;
  }

  function caseLabel(c: any): string {
    const co = companies.find((x) => x.id === c.company_id);
    const label = co ? `${co.security_code} ${co.name_ja}` : '会社未確認';
    const duplicate = cases.some((other) => other.id !== c.id && other.company_id === c.company_id);
    return duplicate ? `${label}（${c.slug}）` : label;
  }

  function renderCaseSelects() {
    const options = '<option value="">案件を選択</option>' + cases
      .map((c) => `<option value="${c.id}">${esc(caseLabel(c))}</option>`)
      .join('');
    for(const id of ['ev-case-select','pr-case-select']) {const sel=$<HTMLSelectElement>(id);const old=sel.value;sel.innerHTML=options;sel.value=old;}
    const evType = $<HTMLSelectElement>('ev-type');
    const currentEventType = evType.value;
    evType.innerHTML = Object.entries(eventTypeDefs)
      .map(([k, v]) => `<option value="${k}">${esc(v.label)}</option>`)
      .join('');
    const restoredEventType = preserveSelectValueIfValid(currentEventType, Object.keys(eventTypeDefs));
    if (restoredEventType) evType.value = restoredEventType;
    updateCommentTagVisibility();
  }

  function renderCaseTable() {
    $('case-admin-table').querySelector('tbody')!.innerHTML = cases
      .map((c) => {
        const co = companies.find((x) => x.id === c.company_id);
        const edition=trackingEditions.find(e=>e.case_id===c.id);
        const profile=edition?.published ?? edition?.draft;
        const status=profile ? PUBLIC_TRACKING_STATUS[publicTrackingStatus(profile)] : null;
        return `<tr>
          <td class="code">${esc(co?.security_code ?? '?')}</td>
          <td>${esc(co?.name_ja ?? '会社未確認')}<div class="small muted mono">/cases/${esc(c.slug)}/</div></td>
          <td>${status?`<span class="badge badge--${status.tone}">${status.label}</span>`:badge(statusDefs[c.status], c.status)}</td>
          <td>${c.is_visible ? '公開対象（反映は未確認）' : '<span class="badge badge--pause">下書き</span>'}</td>
          <td class="nowrap">${fmtDate(c.updated_at)}</td>
          <td><button type="button" class="btn" data-edit-case="${c.id}">編集</button></td>
        </tr>`;
      })
      .join('');
  }

  // ---------------- 出来事 ----------------
  let events: any[] = [];

  async function loadEvents() {
    const caseId = $<HTMLSelectElement>('ev-case-select').value;
    if (!caseId) {
      events = [];
      renderEventTable();
      return;
    }
    const { data, error } = await supabase!
      .from('case_events')
      .select('*')
      .eq('case_id', caseId)
      .order('occurred_at');
    if (error) $('ev-status').textContent = '読み込めませんでした。通信状況と管理者のログイン状態を確認してから、再読み込みしてください。';
    events = data ?? [];
    renderEventTable();
  }

  function renderEventTable() {
    $('event-table').querySelector('tbody')!.innerHTML = events
      .map(
        (e) => `<tr>
          <td class="nowrap">${esc(publicEventDate(e,trackingEditions.find(t=>t.case_id===e.case_id)?.published?.event_dates.find(d=>d.event_id===e.id)).label)}</td>
          <td>${badge(eventTypeDefs[e.event_type], e.event_type)}</td>
          <td>${esc(e.title)}${e.metadata?.corrected ? ' <span class="badge badge--stop">訂正あり</span>' : ''}</td>
          <td>${esc(e.source_name)}</td>
          <td>${e.is_visible ? '公開' : '<span class="badge badge--pause">非公開</span>'}</td>
          <td><button type="button" class="btn" data-edit-event="${e.id}">編集</button></td>
        </tr>`,
      )
      .join('');
  }

  $('ev-case-select')?.addEventListener('change', async () => {
    $('ev-clear').click();
    $('ev-status-suggestion').innerHTML = '';
    await loadEvents();
    updateEventStatusSuggestion();
  });
  $('ev-type')?.addEventListener('change', () => {
    updateCommentTagVisibility();
    updateEventStatusSuggestion();
  });
  document.addEventListener('change', (e) => { if ((e.target as HTMLElement).matches('[data-comment-tag]')) updateCommentStancePreview(); });

  $('ev-corrected')?.addEventListener('change', () => {
    $('ev-correction-row').hidden = !$<HTMLInputElement>('ev-corrected').checked;
  });

  $('ev-date-only')?.addEventListener('change', () => {
    const input = $<HTMLInputElement>('ev-occurred');
    const value = input.value;
    const dateOnly = $<HTMLInputElement>('ev-date-only').checked;
    input.type = dateOnly ? 'date' : 'datetime-local';
    input.value = dateOnly ? value.slice(0, 10) : '';
  });

  $('ev-save')?.addEventListener('click', async () => {
    const id = $<HTMLInputElement>('ev-id').value;
    const corrected = $<HTMLInputElement>('ev-corrected').checked;
    const visible = $<HTMLInputElement>('ev-visible').checked;
    const metadataResult = buildEventMetadata(corrected);
    if (!metadataResult.ok) {
      $('ev-status').textContent = metadataResult.error;
      return;
    }
    const dateOnly = $<HTMLInputElement>('ev-date-only').checked;
    const dateInput = $<HTMLInputElement>('ev-occurred').value;
    const occurredAt = dateOnly ? dateOnlyToIso(dateInput) : localToIso(dateInput);
    if (dateInput && !occurredAt) { $('ev-status').textContent = '有効な日付を入力してください'; return; }
    const row: any = {
      case_id: $<HTMLSelectElement>('ev-case-select').value,
      event_type: $<HTMLSelectElement>('ev-type').value,
      occurred_at: occurredAt,
      title: $<HTMLInputElement>('ev-title').value.trim(),
      summary: $<HTMLTextAreaElement>('ev-summary').value.trim(),
      source_name: $<HTMLInputElement>('ev-source-name').value.trim(),
      source_url: $<HTMLInputElement>('ev-source-url').value.trim(),
      sort_order: Number($<HTMLInputElement>('ev-sort').value) || 0,
      is_visible: visible,
      comment_tags: $<HTMLSelectElement>('ev-type').value === 'company_comment' ? selectedCommentTags() : [],
      comment_stance: $<HTMLSelectElement>('ev-type').value === 'company_comment' ? classifyCommentStance(selectedCommentTags()) : null,
      metadata: { ...metadataResult.metadata, ...(dateOnly && occurredAt ? { date_precision: 'date' } : {}) },
    };
    if (row.source_url && !normalizeHttpUrl(row.source_url)) {
      $('ev-status').textContent = '元情報URLは http/https の絶対URLのみ保存できます';
      return;
    }
    if (row.source_url) row.source_url = normalizeHttpUrl(row.source_url);
    if (!row.case_id || !row.title || !row.source_name) {
      $('ev-status').textContent = '案件・見出し・媒体名は必須です';
      return;
    }
    const existing = events.find((e) => e.id === id);
    if(id&&!existing){$('ev-status').textContent='対象の出来事を読み直してから編集してください';return;}
    const profile=trackingEditions.find(e=>e.case_id===row.case_id)?.published;
    if(existing&&profile?.event_dates.some(d=>d.event_id===id)){
      row.occurred_at=existing.occurred_at;
      row.metadata={...row.metadata,...(existing.metadata?.date_precision?{date_precision:existing.metadata.date_precision}:{})};
    }
    if(!visible&&profile&&(profile.status_event_ids.includes(id)||profile.reports.some(r=>r.event_id===id)||profile.statements.some(s=>s.event_id===id)||profile.event_dates.some(d=>d.event_id===id))){
      $('ev-status').textContent='公開中の分類がこの出来事を参照しています。先に追跡銘柄の根拠・日付指定から外して再承認するか、銘柄全体を非公開にしてください。';return;
    }
    // PR #8適用済みDBの既存レコードに限って日付精度を同期する。
    const dateChanged = (row.occurred_at ? Date.parse(row.occurred_at) : null) !== (existing?.occurred_at ? Date.parse(existing.occurred_at) : null);
    if (existing && 'date_precision' in existing && (dateChanged || dateOnly || existing.date_precision === 'date')) {
      row.date_precision = row.occurred_at ? (dateOnly ? 'date' : 'datetime') : 'unknown';
    }
    if (visible && !existing?.site_published_at) row.site_published_at = new Date().toISOString();
    const q = id
      ? supabase!.from('case_events').update(row).eq('id', id).select('id').single()
      : supabase!.from('case_events').insert(row).select('id').single();
    const { data: savedEvent, error } = await q;
    $('ev-status').textContent = error ? '保存できませんでした。入力内容を控え、通信状況と管理者のログイン状態を確認してから、もう一度保存してください。' : '保存しました';
    updateEventStatusSuggestion();
    if (!error) {
      if (savedEvent?.id) $<HTMLInputElement>('ev-id').value = savedEvent.id;
      if (currentInboxIdForEvent) {
        const approved = await approvePendingInboxItem(currentInboxIdForEvent, 'ev-status');
        if (approved) {
          currentInboxIdForEvent = null;
          await loadInbox();
        }
      }
      await loadEvents();
    }
  });

  function buildEventMetadata(corrected: boolean): { ok: true; metadata: any } | { ok: false; error: string } {
    const eventType = $<HTMLSelectElement>('ev-type').value;
    if (eventType === 'large_shareholding_report') {
      return buildLargeShareholdingMetadata({
        holderName: $<HTMLInputElement>('ev-holder-name').value,
        ratio: $<HTMLInputElement>('ev-ratio').value,
        previousRatio: $<HTMLInputElement>('ev-previous-ratio').value,
        filingDate: $<HTMLInputElement>('ev-filing-date').value,
        changeType: $<HTMLSelectElement>('ev-change-type').value,
        corrected,
        correctionNote: $<HTMLInputElement>('ev-correction-note').value,
      });
    }
    return { ok: true, metadata: corrected ? { corrected: true, correction_note: $<HTMLInputElement>('ev-correction-note').value.trim() } : null };
  }

  $('ev-clear')?.addEventListener('click', () => {
    $<HTMLInputElement>('ev-id').value = '';
    currentInboxIdForEvent = null;
    currentInboxIdForCase = null;
    ($('event-form') as HTMLFormElement).reset();
    $<HTMLInputElement>('ev-occurred').type = 'datetime-local';
    $<HTMLInputElement>('ev-occurred').disabled=false;
    $<HTMLInputElement>('ev-date-only').disabled=false;
    $('ev-correction-row').hidden = true;
    $('ev-status').textContent = '';
    $('ev-status-suggestion').innerHTML = '';
    updateCommentTagVisibility();
  });

  // ---------------- 株価 ----------------
  let prices: any[] = [];

  async function loadPrices() {
    const caseId = $<HTMLSelectElement>('pr-case-select').value;
    if (!caseId) {
      prices = [];
      renderPriceTable();
      return;
    }
    const { data, error } = await supabase!
      .from('price_snapshots')
      .select('*')
      .eq('case_id', caseId)
      .order('price_date', { ascending: false });
    if (error) $('pr-status').textContent = '読み込めませんでした。通信状況と管理者のログイン状態を確認してから、再読み込みしてください。';
    prices = data ?? [];
    renderPriceTable();
  }

  const priceTypeLabel: Record<string, string> = {
    pre_report_close: '観測報道前終値',
    current_close: '現在株価(参考値)',
    formal_offer_price: '正式公開買付価格',
    daily_close: '日次終値',
  };

  function renderPriceTable() {
    $('price-table').querySelector('tbody')!.innerHTML = prices
      .map(
        (p) => `<tr>
          <td>${esc(priceTypeLabel[p.price_type] ?? p.price_type)}</td>
          <td class="num">${Number(p.price).toLocaleString('ja-JP')}円</td>
          <td>${esc(p.price_date)}</td>
          <td>${esc(p.source_name ?? '')}</td>
          <td><button type="button" class="btn" data-edit-price="${p.id}">編集</button></td>
        </tr>`,
      )
      .join('');
  }

  $('pr-case-select')?.addEventListener('change', loadPrices);

  $('pr-save')?.addEventListener('click', async () => {
    const id = $<HTMLInputElement>('pr-id').value;
    const dateOnly = $<HTMLInputElement>('ev-date-only').checked;
    const dateInput = $<HTMLInputElement>('ev-occurred').value;
    const occurredAt = dateOnly ? dateOnlyToIso(dateInput) : localToIso(dateInput);
    if (dateInput && !occurredAt) { $('ev-status').textContent = '有効な日付を入力してください'; return; }
    const row: any = {
      case_id: $<HTMLSelectElement>('pr-case-select').value,
      price_type: $<HTMLSelectElement>('pr-type').value,
      price: $<HTMLInputElement>('pr-price').value,
      price_date: $<HTMLInputElement>('pr-date').value,
      source_name: $<HTMLInputElement>('pr-source').value.trim() || null,
    };
    if (!row.case_id || !row.price || !row.price_date) {
      $('pr-status').textContent = '案件・価格・基準日は必須です';
      return;
    }
    if (row.price_type === 'daily_close') {
      const { data: duplicateRows, error: duplicateError } = await supabase!
        .from('price_snapshots')
        .select('id')
        .eq('case_id', row.case_id)
        .eq('price_type', 'daily_close')
        .eq('price_date', row.price_date);
      if (duplicateError) {
        $('pr-status').textContent = '同じ基準日の株価が登録済みか確認できませんでした。通信状況を確認してから、もう一度保存してください。';
        return;
      }
      if (hasDailyCloseConflict(duplicateRows ?? [], id || null)) {
        $('pr-status').textContent = 'この案件の同じ基準日の日次終値は既に登録されています。既存行を編集してください。';
        return;
      }
    }
    const q = id
      ? supabase!.from('price_snapshots').update(row).eq('id', id)
      : supabase!.from('price_snapshots').insert(row);
    const { error } = await q;
    $('pr-status').textContent = error ? '保存できませんでした。入力内容を控え、通信状況と管理者のログイン状態を確認してから、もう一度保存してください。' : '保存しました';
    if (!error) await loadPrices();
  });

  $('pr-clear')?.addEventListener('click', () => {
    $<HTMLInputElement>('pr-id').value = '';
    ($('price-form') as HTMLFormElement).reset();
  });

  // ---------------- 編集ボタン(行 → フォーム) ----------------
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;

    const inboxNew = t.closest<HTMLButtonElement>('[data-inbox-new-case]');
    if (inboxNew) {
      const item = inboxItems.find((x) => x.id === inboxNew.dataset.inboxNewCase);
      if (!item) return;
      if(!trackingAdmin?.reset())return;
      const companyId = resolveInboxCompanyId(companies, item.security_code);
      if (!companyId) {
        $<HTMLSelectElement>('ca-company').value = '';
        $(`inbox-status-${item.id}`).textContent = '証券コードに一致する会社が見つかりません。先に会社を登録してから再度起票してください。';
        return;
      }
      $<HTMLSelectElement>('ca-company').value = companyId;
      $<HTMLInputElement>('ca-title').value = item.title;
      $<HTMLInputElement>('ca-slug').value = (normalizeSecurityCode(item.security_code) ? `${normalizeSecurityCode(item.security_code).toLowerCase()}-` : '') + 'new-case';
      trackingAdmin?.proposeSlug();
      trackingAdmin?.markDirty();
      $<HTMLTextAreaElement>('ca-summary').value = normalizeHttpUrl(item.url) ?? '';
      currentInboxIdForCase = item.id;
      showTab('cases');
      return;
    }
    const inboxEvent = t.closest<HTMLButtonElement>('[data-inbox-event]');
    if (inboxEvent) {
      const item = inboxItems.find((x) => x.id === inboxEvent.dataset.inboxEvent);
      if (item) prefillEventFromInbox(item);
      return;
    }
    const inboxSelect = t.closest<HTMLInputElement>('[data-inbox-select]');
    if (inboxSelect) {
      if (inboxSelect.checked) selectedInboxIds.add(inboxSelect.dataset.inboxSelect!);
      else selectedInboxIds.delete(inboxSelect.dataset.inboxSelect!);
      updateInboxSelectionSummary();
      return;
    }
    const inboxReject = t.closest<HTMLButtonElement>('[data-inbox-reject]');
    if (inboxReject) {
      const id = inboxReject.dataset.inboxReject!;
      const rejected = await updatePendingInboxStatus(id, 'rejected', `inbox-status-${id}`);
      if (rejected) await loadInbox();
      return;
    }

    const co = t.closest<HTMLButtonElement>('[data-edit-company]');
    if (co) {
      const c = companies.find((x) => x.id === co.dataset.editCompany);
      if (!c) return;
      $<HTMLInputElement>('co-id').value = c.id;
      $<HTMLInputElement>('co-code').value = c.security_code;
      $<HTMLInputElement>('co-name').value = c.name_ja;
      $<HTMLInputElement>('co-market').value = c.market ?? '';
      $<HTMLInputElement>('co-industry').value = c.industry ?? '';
      $<HTMLInputElement>('co-active').checked = c.is_active;
      return;
    }

    const ca = t.closest<HTMLButtonElement>('[data-edit-case]');
    if (ca) {
      const c = cases.find((x) => x.id === ca.dataset.editCase);
      if (!c) return;
      if(await trackingAdmin?.open(c)){currentInboxIdForCase=null;currentInboxIdForEvent=null;}
      return;
    }

    const ev = t.closest<HTMLButtonElement>('[data-edit-event]');
    if (ev) {
      const x = events.find((y) => y.id === ev.dataset.editEvent);
      if (!x) return;
      currentInboxIdForEvent = null;
      currentInboxIdForCase = null;
      $<HTMLInputElement>('ev-id').value = x.id;
      $<HTMLSelectElement>('ev-type').value = x.event_type;
      const dateOnly = (x.date_precision ?? x.metadata?.date_precision) === 'date';
      $<HTMLInputElement>('ev-date-only').checked = dateOnly;
      $<HTMLInputElement>('ev-occurred').type = dateOnly ? 'date' : 'datetime-local';
      $<HTMLInputElement>('ev-occurred').value = dateOnly ? formatDate(x.occurred_at).replaceAll('/', '-') : isoToLocal(x.occurred_at);
      const dateOverride=trackingEditions.find(e=>e.case_id===x.case_id)?.published?.event_dates.some(d=>d.event_id===x.id)??false;
      $<HTMLInputElement>('ev-occurred').disabled=dateOverride;
      $<HTMLInputElement>('ev-date-only').disabled=dateOverride;
      $('ev-status').textContent=dateOverride?'公開用の日付精度が設定されています。日付の修正は「追跡銘柄」→「日付の精度」で行い、下書き保存・公開承認してください。':'';
      $<HTMLInputElement>('ev-title').value = x.title;
      $<HTMLTextAreaElement>('ev-summary').value = x.summary ?? '';
      $<HTMLInputElement>('ev-source-name').value = x.source_name ?? '';
      $<HTMLInputElement>('ev-source-url').value = x.source_url ?? '';
      $<HTMLInputElement>('ev-sort').value = String(x.sort_order ?? 0);
      $<HTMLInputElement>('ev-visible').checked = x.is_visible;
      updateCommentTagVisibility();
      for (const cb of document.querySelectorAll<HTMLInputElement>('[data-comment-tag]')) cb.checked = (x.comment_tags ?? []).includes(cb.value);
      updateCommentStancePreview();
      const corrected = x.metadata?.corrected === true;
      $<HTMLInputElement>('ev-corrected').checked = corrected;
      $('ev-correction-row').hidden = !corrected;
      $<HTMLInputElement>('ev-correction-note').value = x.metadata?.correction_note ?? '';
      $<HTMLInputElement>('ev-holder-name').value = x.metadata?.holder_name ?? '';
      $<HTMLInputElement>('ev-ratio').value = x.metadata?.ratio ?? '';
      $<HTMLInputElement>('ev-previous-ratio').value = x.metadata?.previous_ratio ?? '';
      $<HTMLInputElement>('ev-filing-date').value = x.metadata?.filing_date ?? '';
      $<HTMLSelectElement>('ev-change-type').value = x.metadata?.change_type ?? 'new';
      return;
    }

    const pr = t.closest<HTMLButtonElement>('[data-edit-price]');
    if (pr) {
      const x = prices.find((y) => y.id === pr.dataset.editPrice);
      if (!x) return;
      $<HTMLInputElement>('pr-id').value = x.id;
      $<HTMLSelectElement>('pr-type').value = x.price_type;
      $<HTMLInputElement>('pr-price').value = String(x.price);
      $<HTMLInputElement>('pr-date').value = x.price_date;
      $<HTMLInputElement>('pr-source').value = x.source_name ?? '';
    }
  });

  // ---------------- プレビュー ----------------
  $('preview-close')?.addEventListener('click', () => {
    $('preview-panel').hidden = true;
  });

  // ---------------- 訂正履歴 ----------------
  async function loadCorrections() {
    const { data } = await supabase!
      .from('case_events')
      .select('*')
      .or('event_type.eq.correction,metadata->>corrected.eq.true')
      .order('updated_at', { ascending: false });
    const list = data ?? [];
    $('correction-empty').hidden = list.length > 0;
    $('correction-list').innerHTML = list
      .map((e) => {
        const c = cases.find((x) => x.id === e.case_id);
        return `<div class="card" style="margin-bottom:0.5rem">
          <div class="event-card__head">
            ${badge(eventTypeDefs[e.event_type], e.event_type)}
            <span class="small muted">最終修正: ${fmtDate(e.updated_at)}</span>
          </div>
          <strong>${esc(e.title)}</strong>
          <div class="small muted">${esc(c ? caseLabel(c) : e.case_id)}</div>
          ${e.metadata?.correction_note ? `<p class="small" style="margin:0.3rem 0 0">訂正内容: ${esc(e.metadata.correction_note)}</p>` : ''}
        </div>`;
      })
      .join('');
  }

  // ---------------- 公開処理 ----------------
  $('publish-run')?.addEventListener('click', async () => {
    const statusEl = $('publish-status');
    statusEl.textContent = 'Deploy Hook URL を取得中…';
    const { data, error } = await supabase!
      .from('admin_settings')
      .select('value')
      .eq('key', 'deploy_hook_url')
      .maybeSingle();
    if (error || !data?.value) {
      statusEl.textContent =
        'Deploy Hook URL が未登録です。admin_settings に key=deploy_hook_url を登録してください(docs/SETUP.md 参照)。';
      return;
    }
    statusEl.textContent = '再ビルドを要求しています…';
    try {
      await fetch(data.value, { method: 'POST', mode: 'no-cors' });
      statusEl.textContent =
        '公開処理を要求しました。Cloudflare Pages のビルドが完了するまで数分お待ちください。';
    } catch (err) {
      statusEl.textContent = '再ビルドの依頼結果を確認できませんでした。再実行する前にCloudflare Pagesでビルド状況を確認してください。';
    }
  });

  // ---------------- Supabase MFA (TOTP) ----------------
  let enrollFactorId: string | null = null;

  async function refreshMfaStatus() {
    if (!supabase) return;
    const { data } = await supabase.auth.mfa.listFactors();
    const verified = data?.totp?.filter((f) => f.status === 'verified') ?? [];
    $('mfa-status').textContent = verified.length
      ? `登録済みのTOTP: ${verified.length}件`
      : 'TOTPは未登録です。';
  }

  $('mfa-enroll')?.addEventListener('click', async () => {
    if (!supabase) return;
    const { data, error } = await supabase.auth.mfa.enroll({ factorType: 'totp' });
    if (error || !data) {
      $('mfa-msg').textContent = '認証アプリの登録を開始できませんでした。ログイン状態を確認してから、もう一度お試しください。';
      $('mfa-enroll-panel').hidden = false;
      return;
    }
    enrollFactorId = data.id;
    $('mfa-qr').innerHTML = `<img src="${data.totp.qr_code}" alt="TOTP QRコード" width="180" height="180" />`;
    $('mfa-secret').textContent = `シークレット: ${data.totp.secret}`;
    $('mfa-enroll-panel').hidden = false;
  });

  $('mfa-verify')?.addEventListener('click', async () => {
    if (!supabase || !enrollFactorId) return;
    const code = $<HTMLInputElement>('mfa-code').value.trim();
    const { data: challenge, error: chErr } = await supabase.auth.mfa.challenge({
      factorId: enrollFactorId,
    });
    if (chErr || !challenge) {
      $('mfa-msg').textContent = '認証を開始できませんでした。通信状況を確認し、もう一度認証コードを送信してください。';
      return;
    }
    const { error } = await supabase.auth.mfa.verify({
      factorId: enrollFactorId,
      challengeId: challenge.id,
      code,
    });
    $('mfa-msg').textContent = error
      ? '認証できませんでした。認証アプリに表示されている最新のコードで、もう一度お試しください。'
      : 'TOTPを登録しました。次回ログインからMFAが要求されます。';
    if (!error) refreshMfaStatus();
  });

  init().then(refreshMfaStatus);
</script>
