---
import Base from '../../layouts/Base.astro';
import { CASE_STATUS, EVENT_TYPE, STATUS_ORDER } from '../../lib/status';
import { COMMENT_STANCE_LABELS, COMMENT_TAGS, COMMENT_TAG_ORDER } from '../../lib/commentTags';

// クライアントJSで使う表示定義
const statusDefs = Object.fromEntries(
  STATUS_ORDER.map((s) => [s, { label: CASE_STATUS[s].label, mark: CASE_STATUS[s].mark, tone: CASE_STATUS[s].tone }]),
);
const eventTypeDefs = Object.fromEntries(
  Object.entries(EVENT_TYPE).map(([k, v]) => [k, { label: v.label, mark: v.mark, tone: v.tone }]),
);
const commentTagDefs = COMMENT_TAGS;
const commentTagOrder = COMMENT_TAG_ORDER;
const commentStanceLabels = COMMENT_STANCE_LABELS;
---

<Base
  title="管理画面"
  description="非公開化ウォッチ 管理画面"
  noindex
>
  <h1>管理画面</h1>
  <p class="notice">
    このページは Cloudflare Access で保護されている必要があります(docs/SETUP.md 参照)。
    書き込みはすべて Supabase RLS(admin_users 登録済みUUID)で最終判定されます。
  </p>

  <div id="ad-unconfigured" class="notice" hidden>Supabase が未設定のため管理画面は利用できません。</div>

  <section class="section card" id="ad-auth">
    <div id="ad-logged-out" hidden>
      <p>管理者本人の Google アカウントでログインしてください。</p>
      <button type="button" class="btn btn--primary" id="ad-login">Googleでログイン</button>
    </div>
    <div id="ad-logged-in" hidden>
      <span>ログイン中: <strong id="ad-email"></strong></span>
      <span id="ad-admin-badge" class="badge badge--done" hidden style="margin-left:0.6rem">管理者確認済み</span>
      <span id="ad-not-admin" class="badge badge--stop" hidden style="margin-left:0.6rem">管理者権限がありません</span>
      <button type="button" class="btn" id="ad-logout" style="margin-left:1rem">ログアウト</button>
    </div>
    <div id="ad-mfa-challenge" hidden style="margin-top:0.7rem"><p class="small">登録済みTOTPコードを入力してください。</p><input type="text" id="ad-mfa-code" inputmode="numeric" placeholder="123456" style="max-width:8rem" /> <button type="button" class="btn btn--primary" id="ad-mfa-verify">MFA確認</button></div><p class="small muted" id="ad-auth-status" aria-live="polite"></p>
  </section>

  <div id="ad-main" hidden>
    <nav class="section" aria-label="管理メニュー" style="display:flex; gap:0.4rem; flex-wrap:wrap;">
      <button class="btn" data-tab="inbox">収集候補</button>
      <button class="btn" data-tab="companies">会社</button>
      <button class="btn" data-tab="cases">案件</button>
      <button class="btn" data-tab="events">出来事</button>
      <button class="btn" data-tab="prices">株価</button>
      <button class="btn" data-tab="corrections">訂正履歴</button>
      <button class="btn" data-tab="publish">公開処理</button>
      <button class="btn" data-tab="analytics">アクセス統計</button>
      <button class="btn" data-tab="security">セキュリティ</button>
    </nav>


    <!-- ============ 収集候補 ============ -->
    <section class="section" data-panel="inbox" hidden>
      <h2 class="section-title">収集候補</h2>
      <p class="small muted">自動収集された pending の候補です。自動掲載は行わず、既存フォームへプリフィルして管理者が保存します。</p>
      <div class="card" style="margin-bottom:0.8rem">
        <div style="display:flex; gap:0.6rem; flex-wrap:wrap; align-items:end">
          <label class="small">キーワード検索<br /><input type="search" id="inbox-filter-keyword" placeholder="タイトル・コード・収集元など" /></label>
          <label class="small">掲載日From<br /><input type="date" id="inbox-filter-from" /></label>
          <label class="small">掲載日To<br /><input type="date" id="inbox-filter-to" /></label>
          <button type="button" class="btn" id="inbox-filter-clear">条件クリア</button>
        </div>
        <div style="display:flex; gap:0.4rem; flex-wrap:wrap; align-items:center; margin-top:0.7rem">
          <button type="button" class="btn" id="inbox-select-visible">表示中の候補をすべて選択</button>
          <button type="button" class="btn" id="inbox-select-clear">選択解除</button>
          <button type="button" class="btn" id="inbox-bulk-reject">選択した候補を一括破棄</button>
          <span class="small muted" id="inbox-filter-count">表示中 0件 / pending全体 0件</span>
          <span class="small muted" id="inbox-selected-count">選択 0件</span>
        </div>
        <p class="small" id="inbox-bulk-status" aria-live="polite"></p>
      </div>
      <div id="inbox-list"></div>
      <p class="empty-state" id="inbox-empty" hidden>収集候補はありません。</p>
    </section>

    <!-- ============ 会社 ============ -->
    <section class="section" data-panel="companies" hidden>
      <h2 class="section-title">会社の登録・編集</h2>
      <div class="card" style="margin-bottom:0.8rem">
        <form id="company-form" onsubmit="return false">
          <input type="hidden" id="co-id" />
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:0.6rem;">
            <div class="form-row"><label for="co-code">証券コード *</label><input type="text" id="co-code" required /></div>
            <div class="form-row"><label for="co-name">会社名 *</label><input type="text" id="co-name" required /></div>
            <div class="form-row"><label for="co-market">市場</label><input type="text" id="co-market" placeholder="プライム 等" /></div>
            <div class="form-row"><label for="co-industry">業種</label><input type="text" id="co-industry" /></div>
          </div>
          <label class="filter-check"><input type="checkbox" id="co-active" checked /> 有効</label>
          <div style="display:flex; gap:0.6rem; margin-top:0.6rem;">
            <button type="button" class="btn btn--primary" id="co-save">保存</button>
            <button type="button" class="btn" id="co-clear">クリア(新規)</button>
            <span class="small muted" id="co-status" aria-live="polite"></span>
          </div>
        </form>
      </div>
      <div class="table-wrap"><table class="case-table" id="company-table">
        <thead><tr><th>コード</th><th>会社名</th><th>市場</th><th>業種</th><th>有効</th><th></th></tr></thead>
        <tbody></tbody>
      </table></div>
    </section>

    <!-- ============ 案件 ============ -->
    <section class="section" data-panel="cases" hidden>
      <h2 class="section-title">案件の登録・編集</h2>
      <div class="card" style="margin-bottom:0.8rem">
        <form id="case-form" onsubmit="return false">
          <input type="hidden" id="ca-id" />
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:0.6rem;">
            <div class="form-row"><label for="ca-company">会社 *</label><select id="ca-company" required><option value="">会社を選択</option></select></div>
            <div class="form-row"><label for="ca-title">案件タイトル *</label><input type="text" id="ca-title" required placeholder="〇〇、MBOによる非公開化" /></div>
            <div class="form-row"><label for="ca-slug">スラッグ *(URL: /cases/スラッグ/)</label><input type="text" id="ca-slug" required placeholder="1234-company-name" pattern="[a-z0-9\-]+" /></div>
            <div class="form-row"><label for="ca-status">ステータス *</label><select id="ca-status"></select></div>
            <div class="form-row"><label for="ca-first">最初の観測報道日時</label><input type="datetime-local" id="ca-first" /></div>
          </div>
          <div class="form-row"><label for="ca-summary">概要</label><textarea id="ca-summary" style="min-height:4.5rem"></textarea></div>
          <label class="filter-check"><input type="checkbox" id="ca-visible" /> 公開する(チェックなし=下書き)</label>
          <div style="display:flex; gap:0.6rem; margin-top:0.6rem; flex-wrap:wrap;">
            <button type="button" class="btn btn--primary" id="ca-save">保存</button>
            <button type="button" class="btn" id="ca-clear">クリア(新規)</button>
            <button type="button" class="btn" id="ca-preview">プレビュー</button>
            <span class="small muted" id="ca-status-msg" aria-live="polite"></span>
          </div>
        </form>
      </div>
      <div class="table-wrap"><table class="case-table" id="case-admin-table">
        <thead><tr><th>コード</th><th>案件</th><th>ステータス</th><th>公開</th><th>最終更新</th><th></th></tr></thead>
        <tbody></tbody>
      </table></div>
      <div class="card" id="preview-panel" hidden style="margin-top:1rem; border-color:var(--color-primary);">
        <h3 style="margin-top:0">公開前プレビュー <span class="small muted">(非公開の出来事は「非公開」表示付き)</span></h3>
        <div id="preview-body"></div>
        <button type="button" class="btn" id="preview-close" style="margin-top:0.6rem">閉じる</button>
      </div>
    </section>

    <!-- ============ 出来事 ============ -->
    <section class="section" data-panel="events" hidden>
      <h2 class="section-title">出来事の追加・編集</h2>
      <div class="form-row" style="max-width:26rem">
        <label for="ev-case-select">対象案件</label>
        <select id="ev-case-select"><option value="">案件を選択</option></select>
      </div>
      <div class="card" style="margin-bottom:0.8rem">
        <form id="event-form" onsubmit="return false">
          <input type="hidden" id="ev-id" />
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:0.6rem;">
            <div class="form-row"><label for="ev-type">種類 *</label><select id="ev-type"></select></div>
            <div class="form-row"><label for="ev-occurred">報道・公表日時 *</label><input type="datetime-local" id="ev-occurred" required /></div>
            <div class="form-row"><label for="ev-title">見出し *</label><input type="text" id="ev-title" required /></div>
            <div class="form-row"><label for="ev-source-name">媒体名・発表主体 *</label><input type="text" id="ev-source-name" required /></div>
            <div class="form-row"><label for="ev-source-url">元情報URL</label><input type="url" id="ev-source-url" placeholder="https://…" /></div>
            <div class="form-row"><label for="ev-sort">同時刻内の表示順</label><input type="number" id="ev-sort" value="0" /></div>
          </div>
          <div class="form-row"><label for="ev-summary">中立的な短い説明</label><textarea id="ev-summary" style="min-height:4rem"></textarea></div>
          <div class="form-row" id="ev-comment-tags-row" hidden>
            <label>会社コメントタグ（複数選択可）</label>
            <div id="ev-comment-tags" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:0.35rem"></div>
            <p class="small" id="ev-comment-stance" aria-live="polite"></p>
          </div>
          <label class="filter-check"><input type="checkbox" id="ev-corrected" /> 訂正済み表示を付ける</label>
          <div class="form-row" id="ev-correction-row" hidden><label for="ev-correction-note">訂正内容の説明</label><input type="text" id="ev-correction-note" /></div>
          <div id="ev-large-shareholding-row" hidden style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:0.6rem;">
            <div class="form-row"><label for="ev-holder-name">保有者名 *</label><input type="text" id="ev-holder-name" /></div>
            <div class="form-row"><label for="ev-ratio">保有割合(%) *</label><input type="number" id="ev-ratio" step="0.01" min="0" /></div>
            <div class="form-row"><label for="ev-previous-ratio">前回割合(%)</label><input type="number" id="ev-previous-ratio" step="0.01" min="0" /></div>
            <div class="form-row"><label for="ev-filing-date">提出日</label><input type="date" id="ev-filing-date" /></div>
            <div class="form-row"><label for="ev-change-type">変化</label><select id="ev-change-type"><option value="new">新規</option><option value="increase">増加</option><option value="decrease">減少</option><option value="exit">退出</option></select></div>
          </div>
          <label class="filter-check"><input type="checkbox" id="ev-visible" /> 公開する(チェックなし=非公開)</label>
          <div style="display:flex; gap:0.6rem; margin-top:0.6rem; align-items:center; flex-wrap:wrap;">
            <button type="button" class="btn btn--primary" id="ev-save">保存</button>
            <button type="button" class="btn" id="ev-clear">クリア(新規)</button>
            <span class="small muted" id="ev-status" aria-live="polite"></span>
          </div>
          <p class="small" id="ev-status-suggestion" aria-live="polite"></p>
        </form>
      </div>
      <div class="table-wrap"><table class="case-table" id="event-table">
        <thead><tr><th>日時</th><th>種類</th><th>見出し</th><th>媒体</th><th>公開</th><th></th></tr></thead>
        <tbody></tbody>
      </table></div>
    </section>

    <!-- ============ 株価 ============ -->
    <section class="section" data-panel="prices" hidden>
      <h2 class="section-title">株価情報の登録・編集</h2>
      <div class="form-row" style="max-width:26rem">
        <label for="pr-case-select">対象案件</label>
        <select id="pr-case-select"></select>
      </div>
      <div class="card" style="margin-bottom:0.8rem">
        <form id="price-form" onsubmit="return false">
          <input type="hidden" id="pr-id" />
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:0.6rem;">
            <div class="form-row">
              <label for="pr-type">種類 *</label>
              <select id="pr-type">
                <option value="pre_report_close">観測報道前終値</option>
                <option value="current_close">現在株価(参考値)</option>
                <option value="daily_close">日次終値</option>
                <option value="formal_offer_price">正式公開買付価格</option>
              </select>
            </div>
            <div class="form-row"><label for="pr-price">価格(円)*</label><input type="number" id="pr-price" step="0.01" min="0" required /></div>
            <div class="form-row"><label for="pr-date">基準日 *</label><input type="date" id="pr-date" required /></div>
            <div class="form-row"><label for="pr-source">出典</label><input type="text" id="pr-source" placeholder="取引所公表値(手動登録)" /></div>
          </div>
          <div style="display:flex; gap:0.6rem; margin-top:0.6rem;">
            <button type="button" class="btn btn--primary" id="pr-save">保存</button>
            <button type="button" class="btn" id="pr-clear">クリア(新規)</button>
            <span class="small muted" id="pr-status" aria-live="polite"></span>
          </div>
        </form>
      </div>
      <div class="table-wrap"><table class="case-table" id="price-table">
        <thead><tr><th>種類</th><th class="num">価格</th><th>基準日</th><th>出典</th><th></th></tr></thead>
        <tbody></tbody>
      </table></div>
    </section>

    <!-- ============ 訂正履歴 ============ -->
    <section class="section" data-panel="corrections" hidden>
      <h2 class="section-title">訂正履歴の確認</h2>
      <p class="small muted">「訂正」イベントおよび訂正済み表示の付いた出来事の一覧(最終修正の新しい順)。</p>
      <div id="correction-list"></div>
      <p class="empty-state" id="correction-empty" hidden>訂正履歴はありません。</p>
    </section>

    <!-- ============ 公開処理 ============ -->
    <section class="section" data-panel="publish" hidden>
      <h2 class="section-title">公開処理</h2>
      <div class="card">
        <p class="small">
          「公開処理を実行」を押すと Cloudflare Pages の Deploy Hook が呼び出され、
          現在 Supabase に登録されている公開データ(is_visible = true)で静的サイトが再ビルドされます。
          反映まで数分かかります。
        </p>
        <p class="small muted">
          Deploy Hook URL は Supabase の <code>admin_settings</code> テーブル(key: <code>deploy_hook_url</code>)に登録します(docs/SETUP.md 参照)。
        </p>
        <button type="button" class="btn btn--primary" id="publish-run">公開処理を実行(サイト再ビルド)</button>
        <p class="small" id="publish-status" aria-live="polite"></p>
      </div>
    </section>

    <!-- ============ アクセス統計 ============ -->
    <section class="section" data-panel="analytics" hidden>
      <h2 class="section-title">アクセス統計</h2>
      <div class="card">
        <p class="small muted">Cloudflare GraphQL Analytics API の結果を Pages Function 経由で取得します。APIトークンはクライアントへ埋め込みません。</p>
        <button type="button" class="btn btn--primary" id="analytics-load">統計を再読み込み</button>
        <p class="small" id="analytics-status" aria-live="polite"></p>
        <div id="analytics-summary" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:0.6rem; margin-top:0.8rem"></div>
      </div>
      <div class="table-wrap" style="margin-top:0.8rem"><table class="case-table" id="analytics-url-table">
        <thead><tr><th>URL</th><th class="num">PV</th></tr></thead>
        <tbody></tbody>
      </table></div>
    </section>

    <!-- ============ セキュリティ ============ -->
    <section class="section" data-panel="security" hidden>
      <h2 class="section-title">セキュリティ(Supabase MFA)</h2>
      <div class="card">
        <p class="small">
          Supabase Auth の TOTP(認証アプリ)を登録すると、DB側で aal2 セッションを必須化できます
          (supabase/migrations/0001_init.sql のコメント参照)。
        </p>
        <div id="mfa-status" class="small muted"></div>
        <button type="button" class="btn" id="mfa-enroll">TOTPを新規登録</button>
        <div id="mfa-enroll-panel" hidden style="margin-top:0.8rem">
          <p class="small">認証アプリでQRコードを読み取り、6桁のコードを入力してください。</p>
          <div id="mfa-qr"></div>
          <p class="small mono" id="mfa-secret"></p>
          <input type="text" id="mfa-code" inputmode="numeric" placeholder="123456" style="max-width:8rem" />
          <button type="button" class="btn btn--primary" id="mfa-verify">確認</button>
          <p class="small" id="mfa-msg" aria-live="polite"></p>
        </div>
      </div>
    </section>
  </div>
</Base>

<script is:inline define:vars={{ statusDefs, eventTypeDefs, commentTagDefs, commentTagOrder, commentStanceLabels }}>
  window.__ADMIN_DEFS__ = { statusDefs, eventTypeDefs, commentTagDefs, commentTagOrder, commentStanceLabels };
</script>

<script>
  import { getSupabase } from '../../lib/supabaseBrowser';
  import { buildLargeShareholdingMetadata } from '../../lib/noteMetadataHelpers';
  import { hasDailyCloseConflict } from '../../lib/priceHelpers';
  import { filterInboxItems, inboxEmptyState, normalizeHttpUrl, normalizeSecurityCode, pendingBulkRejectIds, preserveSelectValueIfValid, resolveInboxCaseId, resolveInboxCompanyId, visibleSelectionIds } from '../../lib/inboxAdminHelpers';

  const { statusDefs, eventTypeDefs, commentTagDefs, commentTagOrder, commentStanceLabels } = (window as any).__ADMIN_DEFS__ as {
    statusDefs: Record<string, { label: string; mark: string; tone: string }>;
    eventTypeDefs: Record<string, { label: string; mark: string; tone: string }>;
    commentTagDefs: Record<string, { label: string; description: string; group: string }>;
    commentTagOrder: string[];
    commentStanceLabels: Record<string, string>;
  };

  const supabase = getSupabase();
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: unknown) =>
    String(s ?? '').replace(/[&<>"']/g, (ch) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch] as string,
    );
  const badge = (def: { label: string; mark: string; tone: string } | undefined, fallback: string) =>
    def
      ? `<span class="badge badge--${def.tone}"><span class="badge__mark">${def.mark}</span>${esc(def.label)}</span>`
      : esc(fallback);


  function classifyCommentStance(tags: string[]): string {
    const groups = new Set(tags.map((t) => commentTagDefs[t]?.group).filter(Boolean));
    if (groups.has('acknowledged') && groups.has('denied')) return 'needs_review';
    if (groups.has('acknowledged')) return 'acknowledged';
    if (groups.size === 1 && groups.has('denied')) return 'denied';
    if (groups.size === 1 && groups.has('declined')) return 'declined';
    if (groups.size === 1 && groups.has('neutral')) return 'neutral';
    return 'unclear';
  }
  function selectedCommentTags(): string[] {
    return [...document.querySelectorAll<HTMLInputElement>('[data-comment-tag]:checked')].map((x) => x.value);
  }
  function renderCommentTagUi() {
    $('ev-comment-tags').innerHTML = commentTagOrder.map((tag) => {
      const def = commentTagDefs[tag];
      return `<label class="filter-check"><input type="checkbox" data-comment-tag value="${esc(tag)}" /> ${esc(def.label)}<span class="small muted"> — ${esc(def.description)}</span></label>`;
    }).join('');
    updateCommentStancePreview();
  }
  function updateCommentTagVisibility() {
    const eventType = $<HTMLSelectElement>('ev-type').value;
    const show = eventType === 'company_comment';
    $('ev-large-shareholding-row').hidden = eventType !== 'large_shareholding_report';
    $('ev-comment-tags-row').hidden = !show;
    if (show && !$('ev-comment-tags').innerHTML) renderCommentTagUi();
  }
  function updateCommentStancePreview() {
    const stance = classifyCommentStance(selectedCommentTags());
    $('ev-comment-stance').innerHTML = `自動分類: <strong>${esc(commentStanceLabels[stance] ?? stance)}</strong>${stance === 'needs_review' ? ' <span class="badge badge--stop">公開前に確認</span>' : ''}`;
    updateEventStatusSuggestion();
  }

  function updateEventStatusSuggestion() {
    const suggestion = $('ev-status-suggestion');
    suggestion.innerHTML = '';
    const eventType = $<HTMLSelectElement>('ev-type').value;
    if (eventType !== 'company_comment') return;
    const stance = classifyCommentStance(selectedCommentTags());
    const currentCase = cases.find((c) => c.id === $<HTMLSelectElement>('ev-case-select').value);
    if (!currentCase) return;
    if (stance === 'needs_review') {
      suggestion.innerHTML = '<span class="badge badge--stop">矛盾タグあり</span> acknowledged と denied のタグが同時に選択されています。公開前にタグを確認してください。';
      return;
    }
    let message = '';
    if (stance === 'acknowledged' && currentCase.status === 'rumored') {
      message = '提案: 案件ステータスを「会社が検討を認めた段階」に変更できます。';
    }
    if (stance === 'denied' && !['announced', 'completed', 'withdrawn'].includes(currentCase.status)) {
      message = '提案: 案件ステータスを「会社が明確に否定」に変更できます。';
    }
    if (message) suggestion.innerHTML = `${esc(message)} <button type="button" class="btn" data-go-case-edit>案件編集タブへ</button>`;
  }

  // datetime-local <-> ISO(ブラウザのローカルタイムゾーンで解釈)
  function isoToLocal(iso: string | null): string {
    if (!iso) return '';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '';
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }
  function localToIso(v: string): string | null {
    if (!v) return null;
    const d = new Date(v);
    return Number.isNaN(d.getTime()) ? null : d.toISOString();
  }
  const fmtDate = (iso: string | null) => (iso ? isoToLocal(iso).replace('T', ' ') : '—');

  let pendingMfaFactorId: string | null = null;
  let companies: any[] = [];
  let cases: any[] = [];
  let inboxItems: any[] = [];
  let filteredInboxItems: any[] = [];
  const selectedInboxIds = new Set<string>();
  let inboxBulkRejecting = false;
  let currentInboxIdForCase: string | null = null;
  let currentInboxIdForEvent: string | null = null;

  // ---------------- 認証・管理者判定 ----------------
  async function init() {
    if (!supabase) {
      $('ad-unconfigured').hidden = false;
      return;
    }
    const { data: sessionData } = await supabase.auth.getSession();
    const user = sessionData.session?.user;
    if (!user) {
      $('ad-logged-out').hidden = false;
      return;
    }
    $('ad-logged-in').hidden = false;
    $('ad-email').textContent = user.email ?? '';

    const { data: aal, error: aalErr } = await supabase.auth.mfa.getAuthenticatorAssuranceLevel();
    if (aalErr) { $('ad-auth-status').textContent = `MFA状態の確認に失敗: ${aalErr.message}`; return; }
    if (aal?.currentLevel === 'aal1' && aal?.nextLevel === 'aal2') {
      const { data: factors } = await supabase.auth.mfa.listFactors();
      pendingMfaFactorId = factors?.totp?.find((f) => f.status === 'verified')?.id ?? null;
      $('ad-mfa-challenge').hidden = false;
      $('ad-auth-status').textContent = pendingMfaFactorId ? '管理画面を表示するにはMFA確認が必要です。' : 'aal2が必要ですが登録済みTOTPが見つかりません。セキュリティタブで登録状態を確認してください。';
      return;
    }

    const { data: isAdmin, error } = await supabase.rpc('is_admin');
    if (error || !isAdmin) {
      $('ad-not-admin').hidden = false;
      $('ad-auth-status').textContent =
        'このアカウントは admin_users に登録されていません。管理操作はDB側で拒否されます。';
      return;
    }
    $('ad-admin-badge').hidden = false;
    $('ad-main').hidden = false;
    await reloadAll();
    showTab('cases');
  }

  $('ad-login')?.addEventListener('click', async () => {
    if (!supabase) return;
    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: `${location.origin}/admin/` },
    });
  });
  $('ad-mfa-verify')?.addEventListener('click', async () => {
    if (!supabase || !pendingMfaFactorId) return;
    const code = $<HTMLInputElement>('ad-mfa-code').value.trim();
    const { data: ch, error: chErr } = await supabase.auth.mfa.challenge({ factorId: pendingMfaFactorId });
    if (chErr || !ch) { $('ad-auth-status').textContent = `MFAチャレンジ作成に失敗: ${chErr?.message ?? ''}`; return; }
    const { error } = await supabase.auth.mfa.verify({ factorId: pendingMfaFactorId, challengeId: ch.id, code });
    if (error) { $('ad-auth-status').textContent = `MFA確認に失敗: ${error.message}`; return; }
    location.reload();
  });

  $('ad-logout')?.addEventListener('click', async () => {
    await supabase?.auth.signOut();
    location.reload();
  });

  // ---------------- タブ ----------------
  function showTab(name: string) {
    for (const panel of document.querySelectorAll<HTMLElement>('[data-panel]')) {
      panel.hidden = panel.dataset.panel !== name;
    }
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-tab]')) {
      btn.classList.toggle('btn--primary', btn.dataset.tab === name);
    }
    if (name === 'inbox') loadInbox();
    if (name === 'corrections') loadCorrections();
    if (name === 'analytics') loadAnalytics();
  }
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]');
    if (btn) showTab(btn.dataset.tab ?? 'cases');
    if ((e.target as HTMLElement).closest('[data-go-case-edit]')) showTab('cases');
  });

  async function loadAnalytics() {
    const status = $('analytics-status');
    status.textContent = '読み込み中...';
    try {
      const res = await fetch('/api/analytics', { credentials: 'same-origin' });
      const json = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(json.error ?? `HTTP ${res.status}`);
      const summary = json.summary ?? {};
      $('analytics-summary').innerHTML = [
        ['直近7日 PV', summary.last7Days?.pageViews],
        ['直近7日 訪問数', summary.last7Days?.visits],
        ['直近30日 PV', summary.last30Days?.pageViews],
        ['直近30日 訪問数', summary.last30Days?.visits],
      ].map(([label, value]) => `<div class="price-card"><p class="price-card__label">${esc(label)}</p><p class="price-card__value">${esc(value ?? '—')}</p></div>`).join('');
      $('analytics-url-table').querySelector('tbody')!.innerHTML = (json.topUrls ?? [])
        .map((row: any) => `<tr><td>${esc(row.url)}</td><td class="num">${esc(row.pageViews)}</td></tr>`)
        .join('');
      status.textContent = '読み込みました';
    } catch (e) {
      status.textContent = `読み込みエラー: ${e instanceof Error ? e.message : String(e)}`;
    }
  }

  $('analytics-load')?.addEventListener('click', loadAnalytics);

  async function reloadAll() {
    await Promise.all([loadCompanies(), loadCases()]);
    renderCompanySelects();
    renderCaseSelects();
    renderCompanyTable();
    renderCaseTable();
    await Promise.all([loadEvents(), loadPrices(), loadInbox()]);
  }


  // ---------------- 収集候補 ----------------
  function inboxFilterOptions() {
    return {
      keyword: $<HTMLInputElement>('inbox-filter-keyword')?.value ?? '',
      dateFrom: $<HTMLInputElement>('inbox-filter-from')?.value ?? '',
      dateTo: $<HTMLInputElement>('inbox-filter-to')?.value ?? '',
    };
  }

  function clearInboxSelection() {
    selectedInboxIds.clear();
    renderInbox();
  }

  function updateInboxSelectionSummary() {
    const selectedVisible = visibleSelectionIds(filteredInboxItems, selectedInboxIds);
    $('inbox-selected-count').textContent = `選択 ${selectedVisible.length}件`;
    const bulkButton = $<HTMLButtonElement>('inbox-bulk-reject');
    bulkButton.disabled = inboxBulkRejecting || selectedVisible.length === 0;
  }

  function renderInbox() {
    filteredInboxItems = filterInboxItems(inboxItems, inboxFilterOptions());
    const emptyState = inboxEmptyState(inboxItems.length, filteredInboxItems.length);
    const emptyEl = $('inbox-empty');
    emptyEl.hidden = emptyState === 'none';
    emptyEl.textContent = emptyState === 'no-filter-results' ? '条件に一致する収集候補はありません。' : '収集候補はありません。';
    $('inbox-filter-count').textContent = `表示中 ${filteredInboxItems.length}件 / pending全体 ${inboxItems.length}件`;
    $('inbox-list').innerHTML = filteredInboxItems.map((item) => {
      const matched = cases.find((c) => c.id === item.matched_case_id);
      const raw = item.raw ?? {};
      const checked = selectedInboxIds.has(item.id) ? ' checked' : '';
      return `<article class="card" style="margin-bottom:0.7rem">
        <div class="event-card__head">
          <label class="small"><input type="checkbox" data-inbox-select="${esc(item.id)}"${checked} /> 選択</label>
          <span class="badge badge--watch">${esc(item.source_kind)}</span>
          <span class="small muted">収集: ${fmtDate(item.created_at)} / 公開: ${fmtDate(item.published_at)}</span>
          ${matched ? `<span class="badge badge--comment">既存案件: ${esc(caseLabel(matched))}</span>` : ''}
        </div>
        <h3 style="margin:0.3rem 0">${esc(item.title)}</h3>
        <p class="small muted">証券コード: <span class="mono">${esc(item.security_code ?? '—')}</span> / 推定イベント: ${esc(item.suggested_event_type ?? '—')}</p>
        ${normalizeHttpUrl(item.url) ? `<p class="small"><a href="${esc(normalizeHttpUrl(item.url))}" target="_blank" rel="noopener noreferrer">元URL</a></p>` : `<p class="small muted">元URL: 不正なURLのためリンクを無効化しました</p>`}
        ${raw.metadata_draft ? `<pre class="small" style="white-space:pre-wrap">metadata draft: ${esc(JSON.stringify(raw.metadata_draft, null, 2))}</pre>` : ''}
        <div style="display:flex; gap:0.4rem; flex-wrap:wrap">
          <button type="button" class="btn" data-inbox-new-case="${esc(item.id)}">新規案件として起票</button>
          <button type="button" class="btn" data-inbox-event="${esc(item.id)}">既存案件のイベントとして追加</button>
          <button type="button" class="btn" data-inbox-reject="${esc(item.id)}">破棄</button>
        </div>
        <p class="small" id="inbox-status-${esc(item.id)}" aria-live="polite"></p>
      </article>`;
    }).join('');
    updateInboxSelectionSummary();
  }

  async function loadInbox() {
    const { data, error } = await supabase!
      .from('inbox_items')
      .select('*')
      .eq('status', 'pending')
      .order('created_at', { ascending: false });
    if (error) {
      $('inbox-list').innerHTML = `<p class="notice">読込エラー: ${esc(error.message)}</p>`;
      return;
    }
    inboxItems = (data ?? []).map((item) => ({ ...item, status: item.status ?? 'pending' }));
    selectedInboxIds.clear();
    renderInbox();
  }



  ['inbox-filter-keyword', 'inbox-filter-from', 'inbox-filter-to'].forEach((id) => {
    $(id)?.addEventListener('input', () => {
      selectedInboxIds.clear();
      renderInbox();
    });
  });
  $('inbox-filter-clear')?.addEventListener('click', () => {
    $<HTMLInputElement>('inbox-filter-keyword').value = '';
    $<HTMLInputElement>('inbox-filter-from').value = '';
    $<HTMLInputElement>('inbox-filter-to').value = '';
    selectedInboxIds.clear();
    renderInbox();
  });
  $('inbox-select-visible')?.addEventListener('click', () => {
    filteredInboxItems.forEach((item) => selectedInboxIds.add(item.id));
    renderInbox();
  });
  $('inbox-select-clear')?.addEventListener('click', clearInboxSelection);
  $('inbox-bulk-reject')?.addEventListener('click', async () => {
    const ids = pendingBulkRejectIds(filteredInboxItems, selectedInboxIds);
    if (ids.length === 0 || inboxBulkRejecting) return;
    if (!window.confirm(`選択した収集候補 ${ids.length}件を一括破棄します。よろしいですか？`)) return;
    inboxBulkRejecting = true;
    updateInboxSelectionSummary();
    $('inbox-bulk-status').textContent = '一括破棄中です...';
    const { data, error } = await supabase!
      .from('inbox_items')
      .update({ status: 'rejected', reviewed_at: new Date().toISOString() })
      .eq('status', 'pending')
      .in('id', ids)
      .select('id');
    inboxBulkRejecting = false;
    if (error) {
      $('inbox-bulk-status').textContent = `一括破棄に失敗しました: ${error.message}`;
      updateInboxSelectionSummary();
      return;
    }
    const updated = (data ?? []).length;
    if (updated === ids.length) {
      $('inbox-bulk-status').textContent = `${updated}件を破棄しました。`;
      await loadInbox();
      return;
    }
    $('inbox-bulk-status').textContent = `一括破棄は一部のみ完了しました: 成功 ${updated}件 / 未更新 ${ids.length - updated}件`;
    await loadInbox();
  });

  async function updatePendingInboxStatus(id: string, status: 'approved' | 'rejected', statusElementId: string): Promise<boolean> {
    const statusEl = $(statusElementId);
    const { data, error } = await supabase!
      .from('inbox_items')
      .update({ status, reviewed_at: new Date().toISOString() })
      .eq('id', id)
      .eq('status', 'pending')
      .select('id');
    if (error) {
      statusEl.textContent = `収集候補の${status === 'approved' ? '承認' : '破棄'}更新に失敗しました: ${error.message}`;
      return false;
    }
    if ((data ?? []).length !== 1) {
      statusEl.textContent = `収集候補の${status === 'approved' ? '承認' : '破棄'}更新に失敗しました: pending の対象行が見つかりません。`;
      return false;
    }
    statusEl.textContent = status === 'approved' ? '保存しました（収集候補を承認済みに更新しました）' : '破棄しました';
    return true;
  }

  async function approvePendingInboxItem(id: string, statusElementId: string): Promise<boolean> {
    const approved = await updatePendingInboxStatus(id, 'approved', statusElementId);
    if (!approved) {
      $(statusElementId).textContent += ' 案件／イベントの保存自体は完了しました。承認更新を再試行するにはこのまま再度保存してください。';
    }
    return approved;
  }

  function resetEventFormForInbox() {
    currentInboxIdForEvent = null;
    $<HTMLInputElement>('ev-id').value = '';
    ($('event-form') as HTMLFormElement).reset();
    $<HTMLInputElement>('ev-corrected').checked = false;
    $('ev-correction-row').hidden = true;
    $<HTMLInputElement>('ev-correction-note').value = '';
    for (const cb of document.querySelectorAll<HTMLInputElement>('[data-comment-tag]')) cb.checked = false;
    events = [];
    renderEventTable();
  }

  function prefillEventFromInbox(item: any) {
    currentInboxIdForCase = null;
    currentInboxIdForEvent = null;
    resetEventFormForInbox();
    currentInboxIdForEvent = item.id;
    $<HTMLSelectElement>('ev-case-select').value = resolveInboxCaseId(cases, item.matched_case_id);
    $<HTMLInputElement>('ev-id').value = '';
    $<HTMLSelectElement>('ev-type').value = item.suggested_event_type || 'observation_report';
    $<HTMLInputElement>('ev-occurred').value = isoToLocal(item.published_at || item.created_at);
    $<HTMLInputElement>('ev-title').value = item.title || '';
    $<HTMLTextAreaElement>('ev-summary').value = '';
    $<HTMLInputElement>('ev-source-name').value = item.source_kind || '';
    $<HTMLInputElement>('ev-source-url').value = normalizeHttpUrl(item.url) ?? '';
    $<HTMLInputElement>('ev-visible').checked = false;
    updateCommentTagVisibility();
    for (const cb of document.querySelectorAll<HTMLInputElement>('[data-comment-tag]')) cb.checked = (item.suggested_comment_tags ?? []).includes(cb.value);
    const draft = item.raw?.metadata_draft ?? {};
    $<HTMLInputElement>('ev-holder-name').value = draft.holder_name ?? '';
    $<HTMLInputElement>('ev-ratio').value = draft.ratio ?? '';
    $<HTMLInputElement>('ev-previous-ratio').value = draft.previous_ratio ?? '';
    $<HTMLInputElement>('ev-filing-date').value = draft.filing_date ?? '';
    $<HTMLSelectElement>('ev-change-type').value = draft.change_type ?? 'new';
    updateCommentStancePreview();
    showTab('events');
  }

  // ---------------- 会社 ----------------
  async function loadCompanies() {
    const { data, error } = await supabase!.from('companies').select('*').order('security_code');
    if (error) $('co-status').textContent = `読込エラー: ${error.message}`;
    companies = data ?? [];
  }

  function renderCompanySelects() {
    const sel = $<HTMLSelectElement>('ca-company');
    sel.innerHTML = '<option value="">会社を選択</option>' + companies
      .map((c) => `<option value="${c.id}">${esc(c.security_code)} ${esc(c.name_ja)}</option>`)
      .join('');
  }

  function renderCompanyTable() {
    $('company-table').querySelector('tbody')!.innerHTML = companies
      .map(
        (c) => `<tr>
          <td class="code">${esc(c.security_code)}</td>
          <td>${esc(c.name_ja)}</td>
          <td>${esc(c.market ?? '')}</td>
          <td>${esc(c.industry ?? '')}</td>
          <td>${c.is_active ? '有効' : '無効'}</td>
          <td><button type="button" class="btn" data-edit-company="${c.id}">編集</button></td>
        </tr>`,
      )
      .join('');
