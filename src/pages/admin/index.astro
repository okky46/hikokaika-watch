  // ---------------- 認証・管理者判定 ----------------
  async function init() {
    if (!supabase) {
      $('ad-unconfigured').hidden = false;
      return;
    }
    const { data: sessionData } = await supabase.auth.getSession();
    const user = sessionData.session?.user;
    if (!user) {
      $('ad-logged-out').hidden = false;
      return;
    }
    $('ad-logged-in').hidden = false;
    $('ad-email').textContent = user.email ?? '';

    const { data: aal, error: aalErr } = await supabase.auth.mfa.getAuthenticatorAssuranceLevel();
    if (aalErr) { $('ad-auth-status').textContent = '2段階認証の状態を確認できませんでした。通信状況を確認してから、ページを再読み込みしてください。'; return; }
    if (aal?.currentLevel === 'aal1' && aal?.nextLevel === 'aal2') {
      const { data: factors } = await supabase.auth.mfa.listFactors();
      pendingMfaFactorId = factors?.totp?.find((f) => f.status === 'verified')?.id ?? null;
      $('ad-mfa-challenge').hidden = false;
      $('ad-auth-status').textContent = pendingMfaFactorId ? '管理画面を表示するにはMFA確認が必要です。' : 'aal2が必要ですが登録済みTOTPが見つかりません。セキュリティタブで登録状態を確認してください。';
      return;
    }

    const { data: isAdmin, error } = await supabase.rpc('is_admin');
    if (error || !isAdmin) {
      $('ad-not-admin').hidden = false;
      $('ad-auth-status').textContent =
        'このアカウントは admin_users に登録されていません。管理操作はDB側で拒否されます。';
      return;
    }
    $('ad-admin-badge').hidden = false;
    $('ad-main').hidden = false;
    await reloadAll();
    showTab('cases');
  }

  $('ad-login')?.addEventListener('click', async () => {
    if (!supabase) return;
    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: `${location.origin}/admin/` },
    });
  });
  $('ad-mfa-verify')?.addEventListener('click', async () => {
    if (!supabase || !pendingMfaFactorId) return;
    const code = $<HTMLInputElement>('ad-mfa-code').value.trim();
    const { data: ch, error: chErr } = await supabase.auth.mfa.challenge({ factorId: pendingMfaFactorId });
    if (chErr || !ch) { $('ad-auth-status').textContent = '認証を開始できませんでした。通信状況を確認し、もう一度認証コードを送信してください。'; return; }
    const { error } = await supabase.auth.mfa.verify({ factorId: pendingMfaFactorId, challengeId: ch.id, code });
    if (error) { $('ad-auth-status').textContent = '認証できませんでした。認証アプリに表示されている最新のコードで、もう一度お試しください。'; return; }
    location.reload();
  });

