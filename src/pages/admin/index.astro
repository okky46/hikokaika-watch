          ${matched ? `<span class="badge badge--comment">既存案件: ${esc(caseLabel(matched))}</span>` : ''}
        </div>
        <h3 style="margin:0.3rem 0">${esc(item.title)}</h3>
        <p class="small muted">証券コード: <span class="mono">${esc(item.security_code ?? '—')}</span> / 推定イベント: ${esc(item.suggested_event_type ?? '—')}</p>
        ${normalizeHttpUrl(item.url) ? `<p class="small"><a href="${esc(normalizeHttpUrl(item.url))}" target="_blank" rel="noopener noreferrer">元URL</a></p>` : `<p class="small muted">元URL: 不正なURLのためリンクを無効化しました</p>`}
        ${raw.metadata_draft ? `<pre class="small" style="white-space:pre-wrap">metadata draft: ${esc(JSON.stringify(raw.metadata_draft, null, 2))}</pre>` : ''}
        <div style="display:flex; gap:0.4rem; flex-wrap:wrap">
          <button type="button" class="btn" data-inbox-new-case="${esc(item.id)}">新規案件として起票</button>
          <button type="button" class="btn" data-inbox-event="${esc(item.id)}">既存案件のイベントとして追加</button>
          <button type="button" class="btn" data-inbox-reject="${esc(item.id)}">破棄</button>
        </div>
        <p class="small" id="inbox-status-${esc(item.id)}" aria-live="polite"></p>
      </article>`;
