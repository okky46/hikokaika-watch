---
import Base from '../layouts/Base.astro';
import WatchDesk from '../components/WatchDesk.astro';
import { loadPublicData } from '../lib/publicData';
const { details, isSampleData } = await loadPublicData();


---

<Base
  title="マイページ"
  description="お気に入りの銘柄の変化と、自分の気づき・次の確認日を確認するページ。"
  noindex
>
  <h1>マイページ</h1>

  <div id="mp-unavailable" class="notice" hidden>
    現在ログインできません。銘柄や記事は引き続き閲覧できます。
  </div>
  {isSampleData && <p class="notice">開発・デモ用の<strong>架空のサンプルデータ</strong>です。</p>}
  <WatchDesk cases={details}/>

  <section class="section card" id="mp-auth">
    <div id="mp-logged-out" hidden>
      <p>ログインすると、気になる銘柄をお気に入りに登録し、メモを保存できます。</p>
      <button type="button" class="btn btn--primary" id="mp-login">Googleでログイン</button>
    </div>
    <div id="mp-logged-in" hidden>
      <p style="margin:0 0 0.6rem">
        ログイン中: <strong id="mp-email"></strong>
      </p>
      <button type="button" class="btn" id="mp-logout">ログアウト</button>
    </div>
    <p class="small muted" id="mp-auth-status" aria-live="polite"></p>
  </section>

  <div id="mp-content" hidden>

    <section class="section" aria-label="銘柄ごとのメモ">
      <h2 class="section-title">銘柄ごとのメモ</h2>
      <p class="small muted">メモは銘柄の詳細ページで編集できます。次のチェック日が早い順に並びます。</p>
      <div id="mp-notes"></div>
      <p class="empty-state" id="mp-notes-empty" hidden>銘柄ごとのメモはありません。銘柄詳細の「メモ」で保存してください。</p>
    </section>

    <section class="section" aria-label="全体メモ">
      <h2 class="section-title">全体メモ</h2>
      <div class="card">
        <textarea id="mp-global-note" maxlength="1000" aria-label="全体メモ" placeholder="自分専用の全体メモ"></textarea>
        <div style="display:flex; gap:0.6rem; align-items:center; margin-top:0.5rem;">
          <button type="button" class="btn btn--primary" id="mp-global-save">全体メモを保存</button>
          <span class="small muted" id="mp-global-count">0 / 1,000文字</span><span class="small muted" id="mp-global-status" aria-live="polite"></span>
        </div>
      </div>
    </section>
  </div>
</Base>


<script>
  import { getSupabase, isSupabaseConfigured } from '../lib/supabaseBrowser';
  import { buildNotePreview, hasNoteContent, parseStructuredNote } from '../lib/noteMetadataHelpers';

  type CaseInfo = {
    id: string;
    slug: string;
    securityCode: string;
    companyName: string;
    title: string;
    status: string;
  };


  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const unavailable = $('mp-unavailable');
  const loggedOut = $('mp-logged-out');
  const loggedIn = $('mp-logged-in');
  const emailEl = $('mp-email');
  const content = $('mp-content');
  const authStatus = $('mp-auth-status');
  const notesContainer = $('mp-notes');
  const notesEmpty = $('mp-notes-empty');
  const globalNote = $<HTMLTextAreaElement>('mp-global-note');
  const globalStatus = $('mp-global-status');

  const supabase = getSupabase();

  let userId: string | null = null;
  let caseIndex = new Map<string, CaseInfo>();

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (ch) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch] as string,
    );
  }


  function caseLinkHtml(info: CaseInfo | undefined, caseId: string): string {
    if (!info) return `<span class="muted small">(非公開または削除された案件: ${escapeHtml(caseId.slice(0, 8))}…)</span>`;
    return `<a class="case-link" href="/cases/${encodeURIComponent(info.slug)}/">${escapeHtml(info.companyName)}<span class="mono small">(${escapeHtml(info.securityCode)})</span></a>`;
  }

  async function loadCaseIndex() {
    try {
      const res = await fetch('/data/cases.json');
      const json = await res.json();
      caseIndex = new Map((json.cases as CaseInfo[]).map((c) => [c.id, c]));
    } catch {
      caseIndex = new Map();
    }
  }

  function formatLocalDate(date: Date): string {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }

  async function loadCaseNotes() {
    if (!supabase) return;
    const { data } = await supabase
      .from('user_case_notes')
      .select('case_id, body, updated_at')
      .order('updated_at', { ascending: false });
    const today = formatLocalDate(new Date());
    const notes = (data ?? [])
      .map((n) => ({ ...n, structured: parseStructuredNote(n.body).note }))
      .filter((n) => hasNoteContent(n.structured))
      .sort((a, b) => {
        const ad = a.structured.nextCheckDate || '9999-12-31';
        const bd = b.structured.nextCheckDate || '9999-12-31';
        return ad.localeCompare(bd) || String(b.updated_at).localeCompare(String(a.updated_at));
      });
    notesEmpty.hidden = notes.length > 0;
    notesContainer.innerHTML = notes
      .map((n) => {
        const info = caseIndex.get(n.case_id);
        const preview = buildNotePreview(n.structured);
        const due = n.structured.nextCheckDate && n.structured.nextCheckDate <= today;
        const previewRows = [
          preview.scenario ? `<div><span class="muted">想定シナリオ:</span> ${escapeHtml(preview.scenario)}</div>` : '',
          preview.targetPrice ? `<div><span class="muted">目標価格:</span> ${escapeHtml(preview.targetPrice)}</div>` : '',
          preview.exitCondition ? `<div><span class="muted">撤退条件:</span> ${escapeHtml(preview.exitCondition)}</div>` : '',
          preview.nextCheckDate ? `<div><span class="muted">次のチェック日:</span> ${escapeHtml(preview.nextCheckDate)}</div>` : '',
          preview.freeTextPreview ? `<div style="white-space:pre-wrap;"><span class="muted">自由メモ:</span> ${escapeHtml(preview.freeTextPreview)}</div>` : '',
        ].filter(Boolean).join('');
        return `
        <div class="card ${due ? 'row-highlight' : ''}" style="margin-bottom:0.5rem;">
          <div>${caseLinkHtml(info, n.case_id)} ${due ? '<span class="badge badge--heat-4"><span class="badge__mark">!</span>チェック日を迎えました</span>' : ''}</div>
          <div class="small" style="margin:0.4rem 0 0;">${previewRows}</div>
        </div>`;
      })
      .join('');
  }

  async function loadGlobalNote() {
    if (!supabase || !userId) return;
    const { data } = await supabase.from('user_global_notes').select('body').maybeSingle();
    if (data) globalNote.value = data.body;
  }

  async function init() {
    if (!supabase || !isSupabaseConfigured()) {
      unavailable.hidden = false;
      return;
    }

    const { data: sessionData } = await supabase.auth.getSession();
    const user = sessionData.session?.user;

    if (!user) {
      loggedOut.hidden = false;
      return;
    }

    userId = user.id;
    loggedIn.hidden = false;
    emailEl.textContent = user.email ?? '(メールアドレス不明)';
    content.hidden = false;

    await loadCaseIndex();
    await Promise.all([loadCaseNotes(), loadGlobalNote()]);
  }

  $('mp-login')?.addEventListener('click', async () => {
    if (!supabase) return;
    authStatus.textContent = 'Googleのログイン画面へ移動します…';
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: `${location.origin}/mypage/` },
    });
    if (error) authStatus.textContent = 'ログインできませんでした。通信状況を確認してから、もう一度「Googleでログイン」を選んでください。';
  });

  $('mp-logout')?.addEventListener('click', async () => {
    if (!supabase) return;
    await supabase.auth.signOut();
    location.reload();
  });

  $('mp-global-save')?.addEventListener('click', async () => {
    if (!supabase || !userId) return;
    if (globalNote.value.length > 1000) { globalStatus.textContent = 'メモは1,000文字以内で入力してください。'; return; }
    const btn = $('mp-global-save') as HTMLButtonElement;
    btn.disabled = true;
    globalStatus.textContent = '保存中…';
    const { error } = await supabase
      .from('user_global_notes')
      .upsert({ user_id: userId, body: globalNote.value });
    globalStatus.textContent = error ? '全体メモを保存できませんでした。入力内容を控え、通信状況とログイン状態を確認してから、もう一度保存してください。' : '保存しました';
    btn.disabled = false;
  });

  const updateGlobalCount = () => { const el = $('mp-global-count'); el.textContent = `${globalNote.value.length} / 1,000文字`; };
  globalNote?.addEventListener('input', updateGlobalCount);
  init().then(updateGlobalCount);
</script>
