---
import Base from '../layouts/Base.astro';
import { CASE_STATUS, STATUS_ORDER } from '../lib/status';

// ステータスのラベル・トーンをクライアントJSへ渡す(表示用)
const statusMap = Object.fromEntries(
  STATUS_ORDER.map((s) => [s, { label: CASE_STATUS[s].label, mark: CASE_STATUS[s].mark, tone: CASE_STATUS[s].tone }]),
);
---

<Base
  title="マイページ"
  description="お気に入り案件と自分専用メモの管理ページ。"
  noindex
>
  <h1>マイページ</h1>
  <p class="small muted">
    お気に入り・関心度・メモはあなた専用の情報整理用データです。他のユーザーや管理者向けに公開されることはありません。
  </p>

  <div id="mp-unavailable" class="notice" hidden>
    ログイン機能は現在利用できません(認証サービス未設定)。公開ページの閲覧には影響ありません。
  </div>

  <section class="section card" id="mp-auth">
    <div id="mp-logged-out" hidden>
      <p>Googleアカウントでログインすると、お気に入り登録・関心度設定・自分専用メモが利用できます。</p>
      <button type="button" class="btn btn--primary" id="mp-login">Googleでログイン</button>
    </div>
    <div id="mp-logged-in" hidden>
      <p style="margin:0 0 0.6rem">
        ログイン中: <strong id="mp-email"></strong>
      </p>
      <button type="button" class="btn" id="mp-logout">ログアウト</button>
    </div>
    <p class="small muted" id="mp-auth-status" aria-live="polite"></p>
  </section>

  <div id="mp-content" hidden>
    <section class="section" aria-label="お気に入り案件">
      <h2 class="section-title">お気に入り案件</h2>
      <div class="filter-bar" style="margin-bottom:0.6rem">
        <div class="filter-field">
          <label for="mp-intensity-filter">関心度で絞り込み</label>
          <select id="mp-intensity-filter">
            <option value="">すべて</option>
            <option value="3">3: 最重要</option>
            <option value="2">2: 注目</option>
            <option value="1">1: 経過確認</option>
          </select>
        </div>
      </div>
      <div id="mp-favorites"></div>
      <p class="empty-state" id="mp-fav-empty" hidden>
        お気に入りはまだありません。<a href="/">案件一覧</a>の ☆ から登録できます。
      </p>
    </section>

    <section class="section" aria-label="案件別メモ">
      <h2 class="section-title">案件別メモ</h2>
      <p class="small muted">各案件の詳細ページでメモを編集できます。次のチェック日が今日以前の案件を上部に表示します。</p>
      <div id="mp-notes"></div>
      <p class="empty-state" id="mp-notes-empty" hidden>案件別メモはまだありません。</p>
    </section>

    <section class="section" aria-label="全体メモ">
      <h2 class="section-title">全体メモ</h2>
      <div class="card">
        <p class="small muted" style="margin-bottom:0.5rem">
          特定の案件に紐づかない、あなた専用の自由記述メモです(1件)。
        </p>
        <textarea id="mp-global-note" maxlength="1000" placeholder="全体メモ(本人のみ閲覧可)"></textarea>
        <div style="display:flex; gap:0.6rem; align-items:center; margin-top:0.5rem;">
          <button type="button" class="btn btn--primary" id="mp-global-save">保存</button>
          <span class="small muted" id="mp-global-count">0 / 1,000文字</span><span class="small muted" id="mp-global-status" aria-live="polite"></span>
        </div>
      </div>
    </section>
  </div>
</Base>

<script is:inline define:vars={{ statusMap }}>
  window.__STATUS_MAP__ = statusMap;
</script>

<script>
  import { getSupabase, isSupabaseConfigured } from '../lib/supabaseBrowser';
  import { hasNoteContent, parseStructuredNote } from '../lib/noteMetadataHelpers';

  type CaseInfo = {
    id: string;
    slug: string;
    securityCode: string;
    companyName: string;
    title: string;
    status: string;
  };

  const statusMap = (window as any).__STATUS_MAP__ as Record<
    string,
    { label: string; mark: string; tone: string }
  >;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const unavailable = $('mp-unavailable');
  const loggedOut = $('mp-logged-out');
  const loggedIn = $('mp-logged-in');
  const emailEl = $('mp-email');
  const content = $('mp-content');
  const authStatus = $('mp-auth-status');
  const favContainer = $('mp-favorites');
  const favEmpty = $('mp-fav-empty');
  const notesContainer = $('mp-notes');
  const notesEmpty = $('mp-notes-empty');
  const intensityFilter = $<HTMLSelectElement>('mp-intensity-filter');
  const globalNote = $<HTMLTextAreaElement>('mp-global-note');
  const globalStatus = $('mp-global-status');

  const supabase = getSupabase();

  let userId: string | null = null;
  let caseIndex = new Map<string, CaseInfo>();
  let favorites: { case_id: string; intensity: number; updated_at: string }[] = [];

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (ch) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch] as string,
    );
  }


  function badgeHtml(status: string): string {
    const def = statusMap[status] ?? { label: status, mark: '・', tone: 'pause' };
    return `<span class="badge badge--${def.tone}"><span class="badge__mark" aria-hidden="true">${def.mark}</span>${escapeHtml(def.label)}</span>`;
  }

  function caseLinkHtml(info: CaseInfo | undefined, caseId: string): string {
    if (!info) return `<span class="muted small">(非公開または削除された案件: ${escapeHtml(caseId.slice(0, 8))}…)</span>`;
    return `<a class="case-link" href="/cases/${encodeURIComponent(info.slug)}/">${escapeHtml(info.companyName)}<span class="mono small">(${escapeHtml(info.securityCode)})</span></a> <span class="small muted">${escapeHtml(info.title)}</span>`;
  }

  async function loadCaseIndex() {
    try {
      const res = await fetch('/data/cases.json');
      const json = await res.json();
      caseIndex = new Map((json.cases as CaseInfo[]).map((c) => [c.id, c]));
    } catch {
      caseIndex = new Map();
    }
  }

  function renderFavorites() {
    const filter = intensityFilter.value;
    const items = favorites.filter((f) => !filter || String(f.intensity) === filter);
    favEmpty.hidden = items.length > 0;
    favContainer.innerHTML = items
      .map((f) => {
        const info = caseIndex.get(f.case_id);
        return `
        <div class="card" style="margin-bottom:0.5rem; display:flex; gap:0.8rem; align-items:center; flex-wrap:wrap;">
          ${info ? badgeHtml(info.status) : ''}
          <div style="flex:1; min-width:12rem;">${caseLinkHtml(info, f.case_id)}</div>
          <label class="small muted">関心度
            <select data-fav-intensity="${f.case_id}">
              <option value="1" ${f.intensity === 1 ? 'selected' : ''}>1: 経過確認</option>
              <option value="2" ${f.intensity === 2 ? 'selected' : ''}>2: 注目</option>
              <option value="3" ${f.intensity === 3 ? 'selected' : ''}>3: 最重要</option>
            </select>
          </label>
          <button type="button" class="btn btn--danger" data-fav-remove="${f.case_id}">解除</button>
        </div>`;
      })
      .join('');
  }

  async function loadFavorites() {
    if (!supabase) return;
    const { data } = await supabase
      .from('user_case_favorites')
      .select('case_id, intensity, updated_at')
      .order('updated_at', { ascending: false });
    favorites = data ?? [];
    renderFavorites();
  }

  function formatLocalDate(date: Date): string {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }

  async function loadCaseNotes() {
    if (!supabase) return;
    const { data } = await supabase
      .from('user_case_notes')
      .select('case_id, body, updated_at')
      .order('updated_at', { ascending: false });
    const today = formatLocalDate(new Date());
    const notes = (data ?? [])
      .map((n) => ({ ...n, structured: parseStructuredNote(n.body).note }))
      .filter((n) => hasNoteContent(n.structured))
      .sort((a, b) => {
        const ad = a.structured.nextCheckDate || '9999-12-31';
        const bd = b.structured.nextCheckDate || '9999-12-31';
        return ad.localeCompare(bd) || String(b.updated_at).localeCompare(String(a.updated_at));
      });
    notesEmpty.hidden = notes.length > 0;
    notesContainer.innerHTML = notes
      .map((n) => {
        const info = caseIndex.get(n.case_id);
        const freeText = n.structured.freeText ?? '';
        const preview = freeText.length > 120 ? `${freeText.slice(0, 120)}…` : freeText;
        const due = n.structured.nextCheckDate && n.structured.nextCheckDate <= today;
        return `
        <div class="card ${due ? 'row-highlight' : ''}" style="margin-bottom:0.5rem;">
          <div>${caseLinkHtml(info, n.case_id)} ${due ? '<span class="badge badge--heat-4"><span class="badge__mark">!</span>期日到来</span>' : ''}</div>
          <p class="small" style="margin:0.4rem 0 0;">次のチェック日: ${escapeHtml(n.structured.nextCheckDate || '—')}</p>
          <p class="small" style="margin:0.4rem 0 0; white-space:pre-wrap;">${escapeHtml(preview)}</p>
        </div>`;
      })
      .join('');
  }

  async function loadGlobalNote() {
    if (!supabase || !userId) return;
    const { data } = await supabase.from('user_global_notes').select('body').maybeSingle();
    if (data) globalNote.value = data.body;
  }

  async function init() {
    if (!supabase || !isSupabaseConfigured()) {
      unavailable.hidden = false;
      return;
    }

    const { data: sessionData } = await supabase.auth.getSession();
    const user = sessionData.session?.user;

    if (!user) {
      loggedOut.hidden = false;
      return;
    }

    userId = user.id;
    loggedIn.hidden = false;
    emailEl.textContent = user.email ?? '(メールアドレス不明)';
    content.hidden = false;

    await loadCaseIndex();
    await Promise.all([loadFavorites(), loadCaseNotes(), loadGlobalNote()]);
  }

  $('mp-login')?.addEventListener('click', async () => {
    if (!supabase) return;
    authStatus.textContent = 'Googleへリダイレクトします…';
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: `${location.origin}/mypage/` },
    });
    if (error) authStatus.textContent = `ログインに失敗しました: ${error.message}`;
  });

  $('mp-logout')?.addEventListener('click', async () => {
    if (!supabase) return;
    await supabase.auth.signOut();
    location.reload();
  });

  intensityFilter?.addEventListener('change', renderFavorites);

  document.addEventListener('change', async (e) => {
    const sel = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-fav-intensity]');
    if (!sel || !supabase || !userId) return;
    const caseId = sel.dataset.favIntensity ?? '';
    await supabase
      .from('user_case_favorites')
      .update({ intensity: Number(sel.value) })
      .eq('user_id', userId)
      .eq('case_id', caseId);
    const fav = favorites.find((f) => f.case_id === caseId);
    if (fav) fav.intensity = Number(sel.value);
    if (intensityFilter.value) renderFavorites();
  });

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-fav-remove]');
    if (!btn || !supabase || !userId) return;
    const caseId = btn.dataset.favRemove ?? '';
    btn.disabled = true;
    const { error } = await supabase
      .from('user_case_favorites')
      .delete()
      .eq('user_id', userId)
      .eq('case_id', caseId);
    if (!error) {
      favorites = favorites.filter((f) => f.case_id !== caseId);
      renderFavorites();
    } else {
      btn.disabled = false;
    }
  });

  $('mp-global-save')?.addEventListener('click', async () => {
    if (!supabase || !userId) return;
    if (globalNote.value.length > 1000) { globalStatus.textContent = '1,000文字を超えるメモは保存できません'; return; }
    const btn = $('mp-global-save') as HTMLButtonElement;
    btn.disabled = true;
    globalStatus.textContent = '保存中…';
    const { error } = await supabase
      .from('user_global_notes')
      .upsert({ user_id: userId, body: globalNote.value });
    globalStatus.textContent = error ? `保存に失敗しました: ${error.message}` : '保存しました';
    btn.disabled = false;
  });

  const updateGlobalCount = () => { const el = $('mp-global-count'); el.textContent = `${globalNote.value.length} / 1,000文字`; };
  globalNote?.addEventListener('input', updateGlobalCount);
  init().then(updateGlobalCount);
</script>
