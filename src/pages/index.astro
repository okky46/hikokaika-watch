---
import Base from '../layouts/Base.astro';
import WatchDesk from '../components/WatchDesk.astro';
import {loadPublicData} from '../lib/publicData';
import {watchWorkspaceCase} from '../lib/watchWorkspace';
const {details,isSampleData}=await loadPublicData();
const recent=details.map(watchWorkspaceCase).filter(c=>c.records.length).sort((a,b)=>b.records[0].recorded.localeCompare(a.records[0].recorded)).slice(0,6);
---
<Base title="非公開化ウォッチ" description="気になる銘柄の経過と変化を、前回の続きから確認する。自分の気づきと次に確かめたいことを残せる非公開化ウォッチ。" path="/">
  {isSampleData&&<p class="notice">開発・デモ用の<strong>架空のサンプルデータ</strong>です。実在企業の観察ではありません。</p>}
  <header class="workspace-intro"><div><span class="eyebrow">非公開化ウォッチ</span><h1>気になった、その続きから。</h1><p>前回から何が変わったか。自分は何を確かめたかったか。</p></div><a class="small" href="/mypage/#mp-auth">ログイン・保存先の確認</a></header>
  <WatchDesk cases={details}/>
  <section class="section public-discover" aria-label="公開記録の動き">
    <div class="workspace-heading"><div><span class="eyebrow">新しく気になる銘柄を見つける</span><h2>最近記録された動き</h2></div><a href="/stocks/">全銘柄の経過を見る →</a></div>
    <p class="small muted">公開記録の追加・訂正順です。過去の動きを後から記録したものも含みます。</p>
    <div class="discovery-grid">{recent.map(c=>{const r=c.records[0];return <article class="card"><span class="eyebrow">{r.kind} ／ {c.code}</span><h3><a href={`/cases/${c.slug}/#${r.key}`}>{c.name}</a></h3><h4>{r.title}</h4><p>{r.text}</p><p class="small muted">出来事：{r.when}<br/>記録の更新：{r.recorded.slice(0,10)}</p><a class="small" href={`/cases/${c.slug}/`}>きっかけから確認する →</a></article>})}</div>
    {recent.length===0&&<p class="empty-state">公開記録はこれからです。<a href="/stocks/">追跡対象の銘柄</a>から確認できます。</p>}
  </section>
</Base>
<script>
// Preserve previously shared search URLs while making the home a monitoring workspace.
if(['q','stage','status','media','statement','from','to','sort','issues'].some(key=>new URLSearchParams(location.search).has(key)))location.replace('/stocks/'+location.search);
</script>
