---
import Base from '../layouts/Base.astro';
import TrackingTable from '../components/TrackingTable.astro';
import AdSlot from '../components/AdSlot.astro';
import { loadPublicData } from '../lib/publicData';
import { CASE_STATUS, STATUS_ORDER } from '../lib/status';
import { formatDate, reportYear } from '../lib/format';
const { cases, allSourceNames, isSampleData } = await loadPublicData();
const years = [...new Set(cases.map(c => reportYear(c.firstReportedAt)).filter((y): y is number => y !== null))].sort((a,b) => b-a);
const preCases = cases.filter(c => c.isPreAnnouncement);
const postCases = cases.filter(c => !c.isPreAnnouncement);
const homeAdSlot = import.meta.env.PUBLIC_ADSENSE_SLOT_HOME ?? '';
const hasHomeAd = Boolean(import.meta.env.PUBLIC_ADSENSE_CLIENT && homeAdSlot);
---
<Base title="非公開化ウォッチ" description="以前、非公開化の噂になっていた銘柄は今どうなっている？ 非公開化・MBO・親子上場解消の追跡理由、会社の発表とその後の経過を時系列で整理するデータベース。" path="/" hasAdSlots={hasHomeAd}>
  {isSampleData && <p class="notice">開発・デモ用の<strong>架空のサンプルデータ</strong>です。実在の企業・報道とは関係ありません。</p>}
  <section class="tracking-intro" aria-label="サービス概要">
    <h1>非公開化ウォッチ</h1>
    <p>以前、非公開化の噂になっていた銘柄。<strong>今どうなっている？</strong></p>
    <p class="muted">市場観測をきっかけにした追跡対象と、確認できた報道・会社発表、その後の経過を記録しています。掲載は非公開化の決定や実現可能性を示すものではありません。</p>
    <p class="small"><a href="/articles/">公表資料に基づく記事・調査ノート</a>　<a href="/mypage/">お気に入り・自分専用メモ</a></p>
  </section>
  <section class="section" aria-label="銘柄の検索・絞り込み">
    <h2 class="section-title">追跡銘柄 <span class="small muted">全{cases.length}件</span></h2>
    <p class="small muted">記録の更新が新しい順。記事や報道イベントのない追跡対象も含みます。サイト更新: {formatDate(cases[0]?.lastUpdatedAt)}</p>
    <div class="stock-links" aria-label="主要絞り込み">
      <button type="button" class="btn btn--primary" data-quick-filter="all">すべて</button>
      <button type="button" class="btn" data-quick-filter="acknowledged">会社が検討を認めた</button>
      <button type="button" class="btn" data-quick-filter="announced">正式発表あり</button>
    </div>
    <form class="filter-bar card" id="filter-form" style="margin-bottom:0.8rem" onsubmit="return false">
      <div class="filter-field filter-field--wide">
        <label for="f-q">会社名・証券コード</label>
        <input type="search" id="f-q" placeholder="例: デモ精機 / 0001" autocomplete="off" />
      </div>
      <div class="filter-field">
        <label for="f-status">ステータス</label>
        <select id="f-status">
          <option value="">すべて</option>
          {STATUS_ORDER.map((s) => (
            <option value={s}>{CASE_STATUS[s].label}</option>
          ))}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-source">報道媒体</label>
        <select id="f-source">
          <option value="">すべて</option>
          {allSourceNames.map((s) => (
            <option value={s}>{s}</option>
          ))}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-year">報道年</label>
        <select id="f-year">
          <option value="">すべて</option>
          {years.map((y) => (
            <option value={String(y)}>{y}年</option>
          ))}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-formal">正式発表</label>
        <select id="f-formal">
          <option value="">すべて</option>
          <option value="1">あり</option>
          <option value="0">なし</option>
        </select>
      </div>
      <label class="filter-check" data-login-only hidden>
        <input type="checkbox" id="f-fav" /> お気に入りのみ
      </label>
      <div class="filter-field" data-login-only hidden>
        <label for="f-intensity">関心度</label>
        <select id="f-intensity">
          <option value="">すべて</option>
          <option value="3">3: 最重要</option>
          <option value="2">2: 注目</option>
          <option value="1">1: 経過確認</option>
        </select>
      </div>
      <span class="filter-count" id="filter-count" aria-live="polite"></span>
    </form>


    <h3 class="section-title">正式発表前の追跡対象</h3>
    <TrackingTable cases={preCases} section="pre"/>
    {hasHomeAd && <AdSlot placement="home-between-sections" slotId={homeAdSlot}/>}
    <h3 class="section-title">正式発表後の経過</h3>
    <TrackingTable cases={postCases} section="post"/>
  </section>
  <section class="section card">
    <h2 class="section-title">このデータベースの読み方</h2>
    <p>銘柄の登録と記事の公開は別です。追跡対象への登録は、特定媒体による報道の存在や非公開化の裏付けを意味しません。未読の有料記事の内容は断定せず、確認できた範囲と未確認事項を分けて記録します。</p>
    <p class="small"><a href="/guidelines/">掲載基準・FAQ</a>　<a href="/disclaimer/">免責事項</a></p>
  </section>
</Base>
<script>
  import { getSupabase } from '../lib/supabaseBrowser';

  // ---------- 絞り込み(すべてページ内で完結。外部リクエストなし) ----------
  // 発表前・発表後の2テーブルに対して同じ条件で絞り込む。
  const form = document.getElementById('filter-form') as HTMLFormElement;
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('.case-table tbody tr')];
  const countEl = document.getElementById('filter-count')!;
  const emptyElPre = document.getElementById('empty-state-pre')!;
  const emptyElPost = document.getElementById('empty-state-post')!;
  const rowsPre = [...document.querySelectorAll<HTMLTableRowElement>('#case-table-pre tbody tr')];
  const rowsPost = [...document.querySelectorAll<HTMLTableRowElement>('#case-table-post tbody tr')];

  const q = document.getElementById('f-q') as HTMLInputElement;
  const status = document.getElementById('f-status') as HTMLSelectElement;
  const source = document.getElementById('f-source') as HTMLSelectElement;
  const year = document.getElementById('f-year') as HTMLSelectElement;
  const formal = document.getElementById('f-formal') as HTMLSelectElement;
  let quickFilter = 'all';
  const favOnly = document.getElementById('f-fav') as HTMLInputElement;
  const intensitySel = document.getElementById('f-intensity') as HTMLSelectElement;

  /** case_id -> intensity(ログイン時のみ) */
  let favorites = new Map<string, number>();
  let loggedIn = false;

  function applyFilters() {
    const qv = q.value.trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const d = row.dataset;
      let ok = true;
      if (qv) {
        ok =
          (d.name ?? '').toLowerCase().includes(qv) ||
          (d.code ?? '').toLowerCase().includes(qv);
      }
      if (ok && quickFilter === 'acknowledged') ok = d.acknowledged === '1';
      if (ok && quickFilter === 'announced') ok = d.formal === '1';
      if (ok && status.value) ok = d.status === status.value;
      if (ok && source.value) ok = (d.sources ?? '').split('|').includes(source.value);
      if (ok && year.value) ok = d.year === year.value;
      if (ok && formal.value) ok = d.formal === formal.value;
      if (ok && favOnly.checked) ok = favorites.has(d.caseId ?? '');
      if (ok && intensitySel.value) {
        ok = favorites.get(d.caseId ?? '') === Number(intensitySel.value);
      }
      row.hidden = !ok;
      if (ok) visible++;
    }
    countEl.textContent = `${visible} / ${rows.length} 件`;
    emptyElPre.hidden = rowsPre.some((row) => !row.hidden);
    emptyElPost.hidden = rowsPost.some((row) => !row.hidden);
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-quick-filter]');
    if (!btn) return;
    quickFilter = btn.dataset.quickFilter ?? 'all';
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-quick-filter]')) b.classList.toggle('btn--primary', b === btn);
    applyFilters();
  });
  form.addEventListener('input', applyFilters);
  applyFilters();

  // ---------- お気に入り(ログイン時のみ Supabase に接続) ----------
  const supabase = getSupabase();

  function renderFavButtons() {
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-fav-toggle]')) {
      const id = btn.dataset.favToggle ?? '';
      const on = favorites.has(id);
      btn.textContent = on ? '★' : '☆';
      btn.setAttribute('aria-pressed', String(on));
      btn.title = loggedIn
        ? on
          ? 'お気に入りから外す'
          : 'お気に入りに登録'
        : 'お気に入り(ログインが必要です)';
    }
  }

  async function initFavorites() {
    if (!supabase) return; // ログイン機能が無効な環境ではお気に入りUIは初期状態のまま
    const { data: sessionData } = await supabase.auth.getSession();
    const user = sessionData.session?.user;
    if (!user) return;
    loggedIn = true;
    for (const el of document.querySelectorAll<HTMLElement>('[data-login-only]')) {
      el.hidden = false;
    }
    const { data: favs } = await supabase
      .from('user_case_favorites')
      .select('case_id, intensity');
    favorites = new Map((favs ?? []).map((f) => [f.case_id as string, f.intensity as number]));
    renderFavButtons();
    applyFilters();
  }

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-fav-toggle]');
    if (!btn) return;
    if (!supabase || !loggedIn) {
      if (confirm('お気に入り機能を使うにはログインが必要です。マイページを開きますか?')) {
        location.href = '/mypage/';
      }
      return;
    }
    const caseId = btn.dataset.favToggle ?? '';
    const { data: sessionData } = await supabase.auth.getSession();
    const userId = sessionData.session?.user?.id;
    if (!userId) return;

    btn.disabled = true;
    if (favorites.has(caseId)) {
      const { error } = await supabase
        .from('user_case_favorites')
        .delete()
        .eq('user_id', userId)
        .eq('case_id', caseId);
      if (!error) favorites.delete(caseId);
    } else {
      const { error } = await supabase
        .from('user_case_favorites')
        .upsert({ user_id: userId, case_id: caseId, intensity: 1 });
      if (!error) favorites.set(caseId, 1);
    }
    btn.disabled = false;
    renderFavButtons();
    applyFilters();
  });

  initFavorites();
</script>
