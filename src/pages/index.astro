---
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import AdSlot from '../components/AdSlot.astro';
import { loadPublicData } from '../lib/publicData';
import { CASE_STATUS, STATUS_ORDER } from '../lib/status';
import { isAcknowledgedCase } from '../lib/caseFilters';
import { formatDate, formatPrice, reportYear } from '../lib/format';

const data = await loadPublicData();
const { cases, allSourceNames, isSampleData } = data;

const latestUpdatedAt = cases[0]?.lastUpdatedAt ?? null;

const years = [
  ...new Set(cases.map((c) => reportYear(c.firstReportedAt)).filter((y): y is number => y !== null)),
].sort((a, b) => b - a);

const formUrl = import.meta.env.PUBLIC_REQUEST_FORM_URL ?? '';

const description =
  '上場企業の非公開化・MBO・TOBに関する観測報道、会社コメント、正式発表、その後の経過と株価情報を案件単位で時系列に整理した公開データベース。';
---

<Base title="非公開化ウォッチ" description={description} path="/">
  {isSampleData && (
    <p class="notice">
      現在表示されているのは開発・デモ用の<strong>架空のサンプルデータ</strong>です。実在の企業・報道・株価とは一切関係ありません。
    </p>
  )}

  <section aria-label="サービス概要">
    <h1>非公開化ウォッチ</h1>
    <p class="muted">
      上場企業の非公開化・MBO・TOBについて、<strong>正式発表前の観測報道</strong>から会社コメント、続報、正式発表、撤回・未進展までの経過と株価情報を、案件ごとに時系列で整理した公開データベースです。
      売買推奨や実現可能性の評価を行う投資助言サービスではありません。
    </p>
  </section>

  <p class="small muted" style="margin-top:0.4rem">全{cases.length}件　最終更新：{formatDate(latestUpdatedAt)}</p>

  <AdSlot slotId="home-below-stats" />

  <section class="section" aria-label="案件の検索・絞り込み">
    <h2 class="section-title">案件一覧</h2>
    <div class="section" style="display:flex; gap:0.4rem; flex-wrap:wrap; margin-bottom:0.6rem" aria-label="主要絞り込み">
      <button type="button" class="btn btn--primary" data-quick-filter="all">すべて</button>
      <button type="button" class="btn" data-quick-filter="acknowledged">会社が検討を認めた</button>
      <button type="button" class="btn" data-quick-filter="announced">非公開化公表済み</button>
    </div>

    <form class="filter-bar card" id="filter-form" style="margin-bottom:0.8rem" onsubmit="return false">
      <div class="filter-field filter-field--wide">
        <label for="f-q">会社名・証券コード</label>
        <input type="search" id="f-q" placeholder="例: デモ精機 / 0001" autocomplete="off" />
      </div>
      <div class="filter-field">
        <label for="f-status">ステータス</label>
        <select id="f-status">
          <option value="">すべて</option>
          {STATUS_ORDER.map((s) => (
            <option value={s}>{CASE_STATUS[s].label}</option>
          ))}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-source">報道媒体</label>
        <select id="f-source">
          <option value="">すべて</option>
          {allSourceNames.map((s) => (
            <option value={s}>{s}</option>
          ))}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-year">報道年</label>
        <select id="f-year">
          <option value="">すべて</option>
          {years.map((y) => (
            <option value={String(y)}>{y}年</option>
          ))}
        </select>
      </div>
      <div class="filter-field">
        <label for="f-formal">正式発表</label>
        <select id="f-formal">
          <option value="">すべて</option>
          <option value="1">あり</option>
          <option value="0">なし</option>
        </select>
      </div>
      <label class="filter-check" data-login-only hidden>
        <input type="checkbox" id="f-fav" /> お気に入りのみ
      </label>
      <div class="filter-field" data-login-only hidden>
        <label for="f-intensity">関心度</label>
        <select id="f-intensity">
          <option value="">すべて</option>
          <option value="3">3: 最重要</option>
          <option value="2">2: 注目</option>
          <option value="1">1: 経過確認</option>
        </select>
      </div>
      <span class="filter-count" id="filter-count" aria-live="polite"></span>
    </form>

    <div class="table-wrap">
      <table class="case-table" id="case-table">
        <thead>
          <tr>
            <th scope="col">コード</th>
            <th scope="col">会社名 / 案件</th>
            <th scope="col">ステータス</th>
            <th scope="col">最初の観測報道</th>
            <th scope="col">最初の媒体</th>
            <th scope="col">最終更新</th>
            <th scope="col" class="num">報道前株価</th>
            <th scope="col" class="num">現在株価</th>
            <th scope="col" class="num">正式買付価格</th>
            <th scope="col"><span class="visually-hidden">お気に入り</span>★</th>
          </tr>
        </thead>
        <tbody>
          {cases.map((c) => (
            <tr
              data-case-id={c.id}
              data-name={`${c.companyName} ${c.title}`}
              data-code={c.securityCode}
              data-status={c.status}
              data-sources={c.sourceNames.join('|')}
              data-year={String(reportYear(c.firstReportedAt) ?? '')}
              data-formal={c.hasFormalAnnouncement ? '1' : '0'}
              data-acknowledged={isAcknowledgedCase(c) ? '1' : '0'}
            >
              <td class="code" data-label="証券コード">{c.securityCode}</td>
              <td class="cell-name">
                <a class="case-link" href={`/cases/${c.slug}/`}>{c.companyName}</a>
                <div class="small muted">{c.title}</div>
              </td>
              <td class="cell-status"><StatusBadge status={c.status} /></td>
              <td class="cell-first nowrap" data-label="最初の観測報道">{formatDate(c.firstReportedAt)}</td>
              <td class="cell-source" data-label="最初の媒体">{c.firstSourceName ?? '—'}</td>
              <td class="cell-updated nowrap" data-label="最終更新">{formatDate(c.lastUpdatedAt)}</td>
              <td class="num" data-label="報道前株価">{formatPrice(c.preReportClose?.price)}</td>
              <td class="num" data-label="現在株価">{formatPrice(c.currentClose?.price)}</td>
              <td class="num" data-label="正式買付価格">{formatPrice(c.formalOfferPrice?.price)}</td>
              <td class="fav-cell cell-fav">
                <button
                  type="button"
                  class="fav-toggle"
                  data-fav-toggle={c.id}
                  aria-pressed="false"
                  aria-label={`${c.companyName}をお気に入りに登録`}
                  title="お気に入り(ログインが必要です)"
                >☆</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="empty-state" id="empty-state" hidden>条件に一致する案件はありません。</p>
    </div>
    <p class="small muted" style="margin-top:0.5rem">
      株価は管理者が公開情報をもとに手動登録した参考値です(リアルタイムではありません)。並び順は最終更新日の新しい順です。
    </p>
    {formUrl && (
      <p class="small">
        掲載されていない案件・訂正のご連絡は
        <a href={formUrl} target="_blank" rel="noopener noreferrer">追加掲載・訂正申請フォーム(Googleフォーム)</a>
        からお願いします。
      </p>
    )}
  </section>

  <AdSlot slotId="home-below-list" />

  <section class="section" aria-label="掲載基準">
    <h2 class="section-title">掲載基準(要約)</h2>
    <div class="card">
      <ul style="margin:0; padding-left:1.2em; font-size:0.88rem;">
        <li>掲載対象は、一般に公開されている報道・適時開示・会社発表に限ります。</li>
        <li>未公表情報・内部情報は扱いません。記事本文やスクリーンショットの転載も行いません。</li>
        <li>各出来事には、報道が存在した事実・中立的な短い説明・媒体名・日付・元情報へのリンクのみを掲載します。</li>
        <li>有料媒体の報道についても、内容の詳細転載はせず、報道の存在とリンクのみを記録します。</li>
      </ul>
      <p class="small" style="margin:0.6rem 0 0;"><a href="/guidelines/">掲載基準の全文・FAQを見る</a></p>
    </div>
  </section>

  <section class="section faq" aria-label="よくある質問">
    <h2 class="section-title">FAQ</h2>
    <details>
      <summary>このサイトは投資助言サービスですか?</summary>
      <p>
        いいえ。本サイトは一般公開された情報を時系列で整理する情報アーカイブであり、売買推奨、非公開化の成立確率、報道の信頼度評価などは一切掲載しません。
      </p>
    </details>
    <details>
      <summary>株価はリアルタイムですか?</summary>
      <p>
        いいえ。株価は管理者が公開情報をもとに手動登録した参考値です。「現在株価」には基準日を併記しています。
      </p>
    </details>
    <details>
      <summary>掲載されている観測報道の案件は、必ず非公開化されるのですか?</summary>
      <p>
        いいえ。観測報道は非公開化・MBO・TOB等の実施を保証するものではありません。検討終了や撤回に至った案件も、経過としてそのまま記録します。
      </p>
    </details>
    <p class="small"><a href="/guidelines/#faq">FAQをすべて見る</a></p>
  </section>

  <section class="section" aria-label="免責事項">
    <h2 class="section-title">免責事項(要約)</h2>
    <div class="card">
      <p class="small" style="margin:0;">
        本サイトは情報データベースであり、投資判断の推奨・助言を行うものではありません。掲載情報の正確性・完全性・最新性は保証されません。
        メディアによる報道は金融商品取引法上の「公表」に該当しない場合があります。投資判断は利用者自身の責任で行ってください。
        <a href="/disclaimer/">免責事項の全文を読む</a>
      </p>
    </div>
  </section>
</Base>

<script>
  import { getSupabase } from '../lib/supabaseBrowser';

  // ---------- 絞り込み(すべてページ内で完結。外部リクエストなし) ----------
  const form = document.getElementById('filter-form') as HTMLFormElement;
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('#case-table tbody tr')];
  const countEl = document.getElementById('filter-count')!;
  const emptyEl = document.getElementById('empty-state')!;

  const q = document.getElementById('f-q') as HTMLInputElement;
  const status = document.getElementById('f-status') as HTMLSelectElement;
  const source = document.getElementById('f-source') as HTMLSelectElement;
  const year = document.getElementById('f-year') as HTMLSelectElement;
  const formal = document.getElementById('f-formal') as HTMLSelectElement;
  let quickFilter = 'all';
  const favOnly = document.getElementById('f-fav') as HTMLInputElement;
  const intensitySel = document.getElementById('f-intensity') as HTMLSelectElement;

  /** case_id -> intensity(ログイン時のみ) */
  let favorites = new Map<string, number>();
  let loggedIn = false;

  function applyFilters() {
    const qv = q.value.trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const d = row.dataset;
      let ok = true;
      if (qv) {
        ok =
          (d.name ?? '').toLowerCase().includes(qv) ||
          (d.code ?? '').toLowerCase().includes(qv);
      }
      if (ok && quickFilter === 'acknowledged') ok = d.acknowledged === '1';
      if (ok && quickFilter === 'announced') ok = d.formal === '1';
      if (ok && status.value) ok = d.status === status.value;
      if (ok && source.value) ok = (d.sources ?? '').split('|').includes(source.value);
      if (ok && year.value) ok = d.year === year.value;
      if (ok && formal.value) ok = d.formal === formal.value;
      if (ok && favOnly.checked) ok = favorites.has(d.caseId ?? '');
      if (ok && intensitySel.value) {
        ok = favorites.get(d.caseId ?? '') === Number(intensitySel.value);
      }
      row.hidden = !ok;
      if (ok) visible++;
    }
    countEl.textContent = `${visible} / ${rows.length} 件`;
    emptyEl.hidden = visible > 0;
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-quick-filter]');
    if (!btn) return;
    quickFilter = btn.dataset.quickFilter ?? 'all';
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-quick-filter]')) b.classList.toggle('btn--primary', b === btn);
    applyFilters();
  });
  form.addEventListener('input', applyFilters);
  applyFilters();

  // ---------- お気に入り(ログイン時のみ Supabase に接続) ----------
  const supabase = getSupabase();

  function renderFavButtons() {
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-fav-toggle]')) {
      const id = btn.dataset.favToggle ?? '';
      const on = favorites.has(id);
      btn.textContent = on ? '★' : '☆';
      btn.setAttribute('aria-pressed', String(on));
      btn.title = loggedIn
        ? on
          ? 'お気に入りから外す'
          : 'お気に入りに登録'
        : 'お気に入り(ログインが必要です)';
    }
  }

  async function initFavorites() {
    if (!supabase) return; // ログイン機能が無効な環境ではお気に入りUIは初期状態のまま
    const { data: sessionData } = await supabase.auth.getSession();
    const user = sessionData.session?.user;
    if (!user) return;
    loggedIn = true;
    for (const el of document.querySelectorAll<HTMLElement>('[data-login-only]')) {
      el.hidden = false;
    }
    const { data: favs } = await supabase
      .from('user_case_favorites')
      .select('case_id, intensity');
    favorites = new Map((favs ?? []).map((f) => [f.case_id as string, f.intensity as number]));
    renderFavButtons();
    applyFilters();
  }

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-fav-toggle]');
    if (!btn) return;
    if (!supabase || !loggedIn) {
      if (confirm('お気に入り機能を使うにはログインが必要です。マイページを開きますか?')) {
        location.href = '/mypage/';
      }
      return;
    }
    const caseId = btn.dataset.favToggle ?? '';
    const { data: sessionData } = await supabase.auth.getSession();
    const userId = sessionData.session?.user?.id;
    if (!userId) return;

    btn.disabled = true;
    if (favorites.has(caseId)) {
      const { error } = await supabase
        .from('user_case_favorites')
        .delete()
        .eq('user_id', userId)
        .eq('case_id', caseId);
      if (!error) favorites.delete(caseId);
    } else {
      const { error } = await supabase
        .from('user_case_favorites')
        .upsert({ user_id: userId, case_id: caseId, intensity: 1 });
      if (!error) favorites.set(caseId, 1);
    }
    btn.disabled = false;
    renderFavButtons();
    applyFilters();
  });

  initFavorites();
</script>
