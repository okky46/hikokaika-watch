---
import Base from '../../layouts/Base.astro';
import QuickValuation from '../../components/QuickValuation.astro';
import CaseJourney from '../../components/CaseJourney.astro';
import WatchNotebook from '../../components/WatchNotebook.astro';
import {watchWorkspaceCase} from '../../lib/watchWorkspace';
import TrackingStatus from '../../components/TrackingStatus.astro';
import { REPORT_METHOD, REPORT_ACCESS } from '../../lib/trackingProfile';
import StockLinks from '../../components/StockLinks.astro';
import ArticleList from '../../components/ArticleList.astro';
import { loadValuations } from '../../lib/valuationData';
import { loadPublicData } from '../../lib/publicData';
import { formatDate } from '../../lib/format';
import type { CaseDetail } from '../../lib/types';

export async function getStaticPaths() {
  const data = await loadPublicData();
  return data.details.map((detail) => ({
    params: { slug: detail.slug },
    props: { detail, generatedAt:data.generatedAt, isSampleData: data.isSampleData, articles: data.articles.filter(a => a.companies.some(co => co.id === detail.companyId)) },
  }));
}

interface Props {
  articles: import('../../lib/articles').PublicArticle[];
  detail: CaseDetail;
  isSampleData: boolean;
  generatedAt: string;
}

const { detail: c, isSampleData } = Astro.props;
const valuations = await loadValuations();

const title = `${c.companyName}（${c.securityCode}）の経過`;
const description = `${c.companyName}(証券コード${c.securityCode})の非公開化・MBO・TOBに関する追跡開始から現在までの経過を時系列で整理。${c.summary}`.slice(0, 155);

const timelineAdSlots = [
  import.meta.env.PUBLIC_ADSENSE_SLOT_CASE_TIMELINE_1 ?? '',
  import.meta.env.PUBLIC_ADSENSE_SLOT_CASE_TIMELINE_2 ?? '',
];
const hasTimelineAds = Boolean(import.meta.env.PUBLIC_ADSENSE_CLIENT) && c.events.some((_,i)=> (i+1)%3===0 && timelineAdSlots[(i+1)/3-1]);
const workspace=watchWorkspaceCase(c);

---

<Base title={title} description={description} path={`/cases/${c.slug}/`} hasAdSlots={hasTimelineAds}>
  {isSampleData && (
    <p class="notice">
      このページは開発・デモ用の<strong>架空のサンプルデータ</strong>です。実在の企業・報道・株価とは一切関係ありません。
    </p>
  )}

  <nav class="case-breadcrumb small" aria-label="パンくず">
    <a href="/" id="return-to-results"><span aria-hidden="true">←</span> 銘柄を探す</a><a href="/mypage/#my-watch">マイページ</a><span class="muted">銘柄の経過</span>
  </nav>

  <div data-watch-case={c.id} data-watch-manifest={JSON.stringify(c.watch)}>
  <header id="case-overview" class="case-head case-overview" data-watch-item="summary">
    <div class="case-overview__heading">
      <div>
        <h1>{c.companyName}（{c.securityCode}）の経過</h1>
        <div class="case-overview__identity small">
          {c.market && <span>{c.market}</span>}{c.industry && <span>{c.industry}</span>}
          <a href={`/companies/${c.securityCode}/`}>この企業の案件・記事 <span aria-hidden="true">→</span></a>
          <span class="muted">最終確認 {formatDate(c.lastCheckedOn)}</span>
        </div>
      </div>

    </div>
    <div class="case-overview__summary">
      <section class="case-overview__reason" aria-label="追跡のきっかけ">
        <h2>追跡のきっかけ</h2>
        <p>{c.tracking?.short_reason || c.trackingReason}</p>
        <div class="media-chips">{c.media.map(m=><a class="media-chip" href="#evidence">{m.name}</a>)}</div>
      </section>
      <section class="case-overview__status" aria-label="今の状況">
        <h2>今の状況</h2>
        <TrackingStatus profile={c.tracking} activity={c.activity}/>
      </section>
    </div>
    <StockLinks code={c.securityCode}/>
  </header>

  <nav class="case-section-nav" aria-label="この銘柄のページ内メニュー">
    <div class="case-section-nav__identity">
      <span class="case-section-nav__code">{c.securityCode}</span>
      <span class="case-section-nav__name" title={c.companyName}>{c.companyName}</span>
    </div>
    <a href="#watch-review">変化を確認</a>
    <a href="#watch-history">起点と経過</a>
    <a href="#note-section">気づきを記録</a>
    <a href="#quick-valuation">価格の試算</a>
  </nav>
  <section class="watch-read-bar" id="watch-review" aria-label="前回からの変化"><div><span class="eyebrow">今回見るところ</span><h2>前回からの変化</h2><p data-watch-message aria-live="polite"></p><div data-watch-change-links class="watch-links" aria-label="更新箇所へのリンク"></div><details class="recent-context"><summary>直近に記録された動き</summary><ul>{workspace.records.slice(0,3).map(r=><li><a href={`#${r.key}`}>{r.kind}：{r.title}</a><span class="small muted"> 出来事：{r.when} ／ 記録の更新：{r.recorded.slice(0,10)}</span></li>)}</ul>{!workspace.records.length&&<p>公開の観察・報道はまだありません。追跡のきっかけを起点に記録できます。</p>}</details></div><div class="review-actions"><button type="button" class="btn btn--primary" data-watch-mark>ここまで確認済みにする</button><span class="small muted">確認状態はこのブラウザーに保存</span></div></section>
  <div class="case-workspace">
  <div class="case-workspace-main">
  <CaseJourney c={c} adSlots={timelineAdSlots}/>
  <section class="section" id="evidence" aria-label="媒体と確認した根拠">
    <details class="card evidence-details"><summary>追跡理由と、媒体ごとに確認した根拠を読む</summary>
      <p>{c.trackingReason || '詳しい追跡理由はまだ掲載していません。'}</p>
      {c.tracking?.report_note && <p>{c.tracking.report_note}</p>}
      {c.tracking?.report_state==='none' && <p class="small muted">「報道なし」は、当サイトで報道を確認できていない状態を表します。</p>}
      <ul class="evidence-list">{c.tracking?.reports.map(r=><li><strong>{c.media.find(m=>m.id===r.outlet_id)?.name}</strong> <span class="small">{REPORT_METHOD[r.method]}・{REPORT_ACCESS[r.access]}</span><p>{r.scope_note}</p><a href={r.source_url} target="_blank" rel="noopener noreferrer nofollow">{r.source_name} ↗</a><span class="small muted"> 確認: {formatDate(r.checked_on)}{r.reported_on && ` ／ 報道日: ${formatDate(r.reported_on)}`}</span>{r.event_id && <p class="small"><a href={`#event-${r.event_id}`}>関連する出来事</a></p>}</li>)}</ul>
      {c.tracking?.statements.length ? <><h3>記録した会社説明</h3><ul class="evidence-list">{c.tracking.statements.map(statement=><li><strong>{statement.subject}</strong><p>{statement.text}</p><a href={`#event-${statement.event_id}`}>{c.events.find(e=>e.id===statement.event_id)?.dateLabel} の説明</a></li>)}</ul><p class="small muted">会社説明は発表当時の内容です。その後の変化は「今の状況」と経過タイムラインで確認してください。</p></> : null}
      <dl class="tracking-meta"><div><dt>追跡開始</dt><dd>{formatDate(c.trackingStartedOn)}</dd></div><div><dt>最終確認</dt><dd>{formatDate(c.lastCheckedOn)}</dd></div><div><dt>日付を確認できた最初の報道</dt><dd>{formatDate(c.firstReportedAt)}</dd></div><div><dt>最終更新</dt><dd>{formatDate(c.lastUpdatedAt)}</dd></div><div><dt>サイト掲載</dt><dd>{formatDate(c.sitePublishedAt)}</dd></div></dl>
      {c.verificationNote && <p>{c.verificationNote}</p>}
    </details>
  </section>

  <section class="section" id="related-articles"><h2 class="section-title">関連記事</h2><ArticleList articles={Astro.props.articles}/></section>

  <details class="section valuation-tool" data-valuation-tool><summary>価格の試算を開く</summary>
  <QuickValuation financials={valuations.financials.find(f=>f.code===c.securityCode)} observations={c.tracking?.observations??[]} preReportClose={c.preReportClose} industry={c.industry}/>
  </details>

  </div>
  <WatchNotebook caseId={c.id}/>
  </div>

  </div>

  <section class="section">
    <p class="small">
      この銘柄の続報・会社説明・訂正は、<a href="/requests/">追加掲載・訂正依頼</a>のページから、一般公開された情報源のURLを添えてお知らせください。
    </p>
  </section>
</Base>

<script>
  const timeline=document.getElementById('case-timeline');
  const order=document.getElementById('timeline-order') as HTMLSelectElement|null;
  if(timeline && order) {
    order.closest<HTMLElement>('label')!.hidden=false;
    const events=[...timeline.querySelectorAll<HTMLElement>('[data-timeline-event]')];
    const ads=[...timeline.querySelectorAll<HTMLElement>('.timeline__item--ad')];
    order.addEventListener('change',()=>{
      const key=order.value==='oldest'?'oldestRank':'newestRank';
      const fragment=document.createDocumentFragment();
      let group='';
      events.sort((a,b)=>Number(a.dataset[key])-Number(b.dataset[key])).forEach((event,index)=>{
        const label=event.dataset.timelineGroup!;
        if(label!==group) {const li=document.createElement('li');li.className='timeline-group';const h=document.createElement('h3');h.textContent=label;li.append(h);fragment.append(li);group=label;}
        fragment.append(event);
        if((index+1)%3===0 && ads[(index+1)/3-1])fragment.append(ads[(index+1)/3-1]);
      });
      timeline.replaceChildren(fragment);
      document.dispatchEvent(new Event('journey-order-changed'));
    });
  }
  const back=document.getElementById('return-to-results') as HTMLAnchorElement;
  try {const query=sessionStorage.getItem('tracking-public-search');if(query)back.href='/?'+query;}catch{}
  const evidenceSection=document.getElementById('evidence')!;
  const evidenceDetails=evidenceSection.querySelector<HTMLDetailsElement>('details')!;
  // Expand before the browser positions the anchor, including repeat clicks on the same hash.
  document.querySelectorAll('a[href="#evidence"]').forEach(link=>link.addEventListener('click',()=>{evidenceDetails.open=true;}));
  function openEvidence() {if(location.hash==='#evidence'){evidenceDetails.open=true;evidenceSection.scrollIntoView();}}
  openEvidence();window.addEventListener('hashchange',openEvidence);
  const sectionNav=document.querySelector<HTMLElement>('.case-section-nav')!;
  function updateSectionNav() {
    const links=[...sectionNav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const visible=links.map(link=>({link,section:document.getElementById(link.hash.slice(1))})).filter(item=>item.section && !item.section.hidden);
    const cutoff=sectionNav.getBoundingClientRect().bottom+32;
    let current=visible.filter(item=>item.link.hash!=='#note-section'&&item.section!.getBoundingClientRect().top<=cutoff).at(-1) ?? visible[0];
    // A short final section cannot always scroll all the way to the sticky navigation.
    const hashTarget=visible.find(item=>item.link.hash===location.hash);
    if(hashTarget && hashTarget.section!.getBoundingClientRect().top<window.innerHeight && hashTarget.section!.getBoundingClientRect().bottom>cutoff)current=hashTarget;
    for(const link of links) {
      if(link===current?.link)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');
    }
  }
  let navFrame=0;
  const scheduleNav=()=>{if(!navFrame)navFrame=requestAnimationFrame(()=>{navFrame=0;updateSectionNav();});};
  window.addEventListener('scroll',scheduleNav,{passive:true});
  window.addEventListener('resize',scheduleNav);
  window.addEventListener('hashchange',scheduleNav);
  window.addEventListener('pageshow',scheduleNav);
  document.querySelector('#evidence details')?.addEventListener('toggle',scheduleNav);
  scheduleNav();
  const valuationTool=document.querySelector<HTMLDetailsElement>('[data-valuation-tool]')!;
  function revealValuation(){if(['#quick-valuation','#valuation','#valuation-sources'].includes(location.hash)){valuationTool.open=true;document.getElementById(location.hash.slice(1))?.scrollIntoView();}}
  document.querySelectorAll('a[href="#quick-valuation"]').forEach(link=>link.addEventListener('click',()=>valuationTool.open=true));
  window.addEventListener('hashchange',revealValuation);revealValuation();
</script>
