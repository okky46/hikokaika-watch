---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import StatusFunnel from '../../components/StatusFunnel.astro';
import EventTypeBadge from '../../components/EventTypeBadge.astro';
import AdSlot from '../../components/AdSlot.astro';
import { loadPublicData } from '../../lib/publicData';
import { formatDate, formatDateTime, daysBetween } from '../../lib/format';
import { formatPrice } from '../../lib/format';
import type { CaseDetail } from '../../lib/types';

export async function getStaticPaths() {
  const data = await loadPublicData();
  return data.details.map((detail) => ({
    params: { slug: detail.slug },
    props: { detail, isSampleData: data.isSampleData },
  }));
}

interface Props {
  detail: CaseDetail;
  isSampleData: boolean;
}

const { detail: c, isSampleData } = Astro.props;
const formUrl = import.meta.env.PUBLIC_REQUEST_FORM_URL ?? '';

const title = `${c.companyName}(${c.securityCode})${c.title.includes(c.companyName) ? '' : ` ${c.title}`}の経過`;
const description = `${c.companyName}(証券コード${c.securityCode})の非公開化・MBO・TOB関連の観測報道から現在までの経過を時系列で整理。${c.summary}`.slice(0, 155);

const elapsed = daysBetween(c.firstReportedAt, c.lastUpdatedAt);
const timelineAdSlots = [
  import.meta.env.PUBLIC_ADSENSE_SLOT_CASE_TIMELINE_1 ?? '',
  import.meta.env.PUBLIC_ADSENSE_SLOT_CASE_TIMELINE_2 ?? '',
];
const hasTimelineAds = Boolean(import.meta.env.PUBLIC_ADSENSE_CLIENT) && timelineAdSlots.some(Boolean);
const timelineRows = c.events.flatMap((event, index) => {
  const rows: ({ type: 'event'; event: typeof event } | { type: 'ad'; slotNumber: number })[] = [{ type: 'event', event }];
  const slotNumber = Math.floor((index + 1) / 3);
  if ((index + 1) % 3 === 0 && slotNumber <= 2 && timelineAdSlots[slotNumber - 1]) rows.push({ type: 'ad', slotNumber });
  return rows;
});
---

<Base title={title} description={description} path={`/cases/${c.slug}/`} hasAdSlots={hasTimelineAds}>
  {isSampleData && (
    <p class="notice">
      このページは開発・デモ用の<strong>架空のサンプルデータ</strong>です。実在の企業・報道・株価とは一切関係ありません。
    </p>
  )}

  <nav class="small" aria-label="パンくず" style="margin-bottom:0.8rem">
    <a href="/">案件一覧</a> › <span class="muted">{c.companyName}({c.securityCode})</span>
  </nav>

  <header class="case-head">
    <p class="case-head__company">
      <a class="mono" href={`/companies/${c.securityCode}/`}>{c.securityCode}</a>
      {c.market && <span> / {c.market}</span>}
      {c.industry && <span> / {c.industry}</span>}
    </p>
    <h1><a href={`/companies/${c.securityCode}/`}>{c.companyName}</a> — {c.title}</h1>
    <div style="display:flex; align-items:center; gap:0.7rem; flex-wrap:wrap;">
      <StatusBadge
        status={c.effectiveStatus}
        reportCount={c.reportCount}
        commentCount={c.commentCount}
        heatLevel={c.heatLevel}
      />
      <button
        type="button"
        class="btn"
        id="fav-btn"
        data-case-id={c.id}
        hidden
      >☆ お気に入りに登録</button>
      <select id="fav-intensity" class="small" hidden aria-label="関心度">
        <option value="1">関心度 1: 経過確認</option>
        <option value="2">関心度 2: 注目</option>
        <option value="3">関心度 3: 最重要</option>
      </select>
    </div>
    <div class="case-head__meta">
      <span>最初の観測報道: {formatDate(c.firstReportedAt)}</span>
      <span>最終更新: {formatDate(c.lastUpdatedAt)}</span>
      {elapsed !== null && <span>最初の報道からの経過日数: {elapsed}日</span>}
      <span>サイト掲載: {formatDate(c.sitePublishedAt)}</span>
    </div>
    <p style="margin-top:0.6rem">{c.summary}</p>
  </header>

  <StatusFunnel
    effectiveStatus={c.effectiveStatus}
    reportCount={c.reportCount}
    commentCount={c.commentCount}
    heatLevel={c.heatLevel}
  />

  <section class="section" aria-label="株価情報">
    <h2 class="section-title">株価情報</h2>
    <div class="price-grid">
      <div class="price-card">
        <p class="price-card__label">観測報道前の終値</p>
        <p class="price-card__value">{formatPrice(c.preReportClose?.price)}</p>
        {c.preReportClose && <p class="price-card__date">{formatDate(c.preReportClose.priceDate)} 時点</p>}
      </div>
      <div class="price-card">
        <p class="price-card__label">現在株価(参考値)</p>
        <p class="price-card__value">{formatPrice(c.currentClose?.price)}</p>
        {c.currentClose && <p class="price-card__date">基準日: {formatDate(c.currentClose.priceDate)}</p>}
      </div>
      {c.formalOfferPrice && (
        <div class="price-card">
          <p class="price-card__label">正式公開買付価格</p>
          <p class="price-card__value">{formatPrice(c.formalOfferPrice.price)}</p>
          <p class="price-card__date">{formatDate(c.formalOfferPrice.priceDate)} 発表</p>
        </div>
      )}
    </div>
    {c.sparklineSvg && <div class="sparkline-detail" set:html={c.sparklineSvg} />}
    <p class="small muted" style="margin-top:0.4rem">
      ※ 株価は管理者が公開情報をもとに手動登録した参考値であり、リアルタイム情報ではありません。
    </p>
  </section>

  <section class="section" aria-label="出来事タイムライン">
    <h2 class="section-title">経過タイムライン</h2>
    {c.events.length === 0 ? (
      <p class="empty-state">公開されている出来事はまだありません。</p>
    ) : (
      <ol class="timeline">
        {timelineRows.map((row) => row.type === 'ad' ? (
          <li class="timeline__item timeline__item--ad">
            <AdSlot placement={`case-timeline-${row.slotNumber}`} slotId={timelineAdSlots[row.slotNumber - 1]} />
          </li>
        ) : (
          <li class="timeline__item">
            <article class="event-card">
              <div class="event-card__head">
                <EventTypeBadge type={row.event.eventType} />
                <span class="event-card__date">{formatDateTime(row.event.occurredAt)}</span>
                {row.event.corrected && (
                  <span class="badge badge--stop"><span class="badge__mark" aria-hidden="true">!</span>訂正あり</span>
                )}
              </div>
              <h3 class="event-card__title">{row.event.title}</h3>
              {row.event.summary && <p class="event-card__summary">{row.event.summary}</p>}
              {row.event.largeShareholding && (
                <p class="event-card__summary"><strong>{row.event.largeShareholding.holderName}</strong> — <strong>保有 {row.event.largeShareholding.ratio.toFixed(2)}%</strong>{row.event.largeShareholding.previousRatio !== null && ` (前回 ${row.event.largeShareholding.previousRatio.toFixed(2)}%)`}</p>
              )}
              {row.event.corrected && row.event.correctionNote && (
                <p class="event-card__summary" style="color:var(--tone-stop-fg)">訂正: {row.event.correctionNote}</p>
              )}
              <div class="event-card__meta">
                <span>出典: {row.event.sourceUrl ? (
                  <a href={row.event.sourceUrl} target="_blank" rel="noopener noreferrer nofollow">{row.event.sourceName || '元情報'}</a>
                ) : (
                  row.event.sourceName || '—'
                )}</span>
                <span>本サイト初回掲載: {formatDateTime(row.event.sitePublishedAt)}</span>
                {row.event.updatedAt !== row.event.sitePublishedAt && <span>最終修正: {formatDateTime(row.event.updatedAt)}</span>}
              </div>
            </article>
          </li>
        ))}
      </ol>
    )}
    <p class="small muted">
      各出来事には、報道・発表が存在した事実と中立的な説明のみを掲載しています。記事本文の転載は行いません。
    </p>
  </section>

  <section class="section" aria-label="自分専用メモ" id="note-section" hidden>
    <h2 class="section-title">自分専用メモ</h2>
    <div class="card">
      <p class="small muted" style="margin-bottom:0.5rem">
        このメモはあなただけが閲覧できる私的な整理用メモです。他のユーザーや管理者向けに公開されることはありません。
      </p>
      <div class="note-grid">
        <label>想定シナリオ<input type="text" id="note-scenario" /></label>
        <label>目標価格<input type="text" id="note-target-price" /></label>
        <label>撤退条件<input type="text" id="note-exit-condition" /></label>
        <label>次のチェック日<input type="date" id="note-next-check-date" /></label>
        <label style="grid-column:1/-1">自由メモ<textarea id="note-body" maxlength="1000" placeholder="この案件についての自分用メモ(本人のみ閲覧可)"></textarea></label>
      </div>
      <div style="display:flex; gap:0.6rem; align-items:center; margin-top:0.5rem;">
        <button type="button" class="btn btn--primary" id="note-save">メモを保存</button>
        <span class="small muted" id="note-count">0 / 1,000文字</span><span class="small muted" id="note-status" aria-live="polite"></span>
      </div>
    </div>
  </section>


  {formUrl && (
    <section class="section">
      <p class="small">
        この案件の続報・会社コメント・訂正のご連絡は
        <a href={formUrl} target="_blank" rel="noopener noreferrer">追加掲載・訂正申請フォーム(Googleフォーム)</a>
        からお願いします。
      </p>
    </section>
  )}
</Base>

<script>
  import { getSupabase } from '../../lib/supabaseBrowser';
  import { chooseNoteSaveBody, parseStructuredNote } from '../../lib/noteMetadataHelpers';
  import type { LoadedNoteFormat, SaveNoteResult, StructuredNotePayload } from '../../lib/noteMetadataHelpers';

  const supabase = getSupabase();
  const favBtn = document.getElementById('fav-btn') as HTMLButtonElement;
  const intensitySel = document.getElementById('fav-intensity') as HTMLSelectElement;
  const noteSection = document.getElementById('note-section') as HTMLElement;
  const noteBody = document.getElementById('note-body') as HTMLTextAreaElement;
  const noteScenario = document.getElementById('note-scenario') as HTMLInputElement;
  const noteTargetPrice = document.getElementById('note-target-price') as HTMLInputElement;
  const noteExitCondition = document.getElementById('note-exit-condition') as HTMLInputElement;
  const noteNextCheckDate = document.getElementById('note-next-check-date') as HTMLInputElement;
  const noteSave = document.getElementById('note-save') as HTMLButtonElement;
  const noteStatus = document.getElementById('note-status') as HTMLElement;
  const caseId = favBtn?.dataset.caseId ?? '';

  let userId: string | null = null;
  let isFavorite = false;
  let loadedNoteFormat: LoadedNoteFormat = 'v1';

  function fillNote(body: string) {
    const parsed = parseStructuredNote(body);
    const n = parsed.note;
    loadedNoteFormat = parsed.format;
    noteScenario.value = n.scenario;
    noteTargetPrice.value = n.targetPrice;
    noteExitCondition.value = n.exitCondition;
    noteNextCheckDate.value = n.nextCheckDate;
    noteBody.value = n.freeText;
  }

  function currentNotePayload(): StructuredNotePayload {
    return { v: 1, scenario: noteScenario.value, targetPrice: noteTargetPrice.value, exitCondition: noteExitCondition.value, nextCheckDate: noteNextCheckDate.value, freeText: noteBody.value };
  }

  function buildSaveNoteBody(): SaveNoteResult {
    return chooseNoteSaveBody(currentNotePayload(), loadedNoteFormat);
  }

  function renderFav() {
    favBtn.textContent = isFavorite ? '★ お気に入り登録済み' : '☆ お気に入りに登録';
    intensitySel.hidden = !isFavorite;
  }

  async function init() {
    if (!supabase) return;
    const { data: sessionData } = await supabase.auth.getSession();
    const user = sessionData.session?.user;
    if (!user) return;
    userId = user.id;

    favBtn.hidden = false;
    noteSection.hidden = false;

    const [{ data: fav }, { data: note }] = await Promise.all([
      supabase
        .from('user_case_favorites')
        .select('intensity')
        .eq('case_id', caseId)
        .maybeSingle(),
      supabase
        .from('user_case_notes')
        .select('body')
        .eq('case_id', caseId)
        .maybeSingle(),
    ]);

    if (fav) {
      isFavorite = true;
      intensitySel.value = String(fav.intensity);
    }
    if (note) fillNote(note.body);
    renderFav();
  }

  favBtn?.addEventListener('click', async () => {
    if (!supabase || !userId) return;
    favBtn.disabled = true;
    if (isFavorite) {
      const { error } = await supabase
        .from('user_case_favorites')
        .delete()
        .eq('user_id', userId)
        .eq('case_id', caseId);
      if (!error) isFavorite = false;
    } else {
      const { error } = await supabase
        .from('user_case_favorites')
        .upsert({ user_id: userId, case_id: caseId, intensity: Number(intensitySel.value) || 1 });
      if (!error) isFavorite = true;
    }
    favBtn.disabled = false;
    renderFav();
  });

  intensitySel?.addEventListener('change', async () => {
    if (!supabase || !userId || !isFavorite) return;
    await supabase
      .from('user_case_favorites')
      .update({ intensity: Number(intensitySel.value) })
      .eq('user_id', userId)
      .eq('case_id', caseId);
  });

  noteSave?.addEventListener('click', async () => {
    if (!supabase || !userId) return;
    const saveBody = buildSaveNoteBody();
    if (!saveBody.ok) { noteStatus.textContent = saveBody.message; updateNoteCount(); return; }
    const body = saveBody.body;
    noteSave.disabled = true;
    noteStatus.textContent = '保存中…';
    const { error } = await supabase
      .from('user_case_notes')
      .upsert({ user_id: userId, case_id: caseId, body });
    if (!error) loadedNoteFormat = saveBody.format;
    noteStatus.textContent = error ? `保存に失敗しました: ${error.message}` : '保存しました';
    noteSave.disabled = false;
    updateNoteCount();
  });

  const updateNoteCount = () => {
    const el = document.getElementById('note-count');
    if (!el) return;
    const saveBody = buildSaveNoteBody();
    el.textContent = `${saveBody.length} / 1,000文字${saveBody.ok ? '' : '（超過）'}`;
  };
  noteBody?.addEventListener('input', updateNoteCount);
  noteScenario?.addEventListener('input', updateNoteCount);
  noteTargetPrice?.addEventListener('input', updateNoteCount);
  noteExitCondition?.addEventListener('input', updateNoteCount);
  noteNextCheckDate?.addEventListener('input', updateNoteCount);
  init().then(updateNoteCount);
</script>
