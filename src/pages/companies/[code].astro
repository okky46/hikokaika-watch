---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { loadPublicData } from '../../lib/publicData';
import { formatDate } from '../../lib/format';
import type { PublicCompany } from '../../lib/types';

export async function getStaticPaths() {
  const data = await loadPublicData();
  return data.companies.map((company) => ({ params: { code: company.securityCode }, props: { company, isSampleData: data.isSampleData } }));
}

interface Props { company: PublicCompany; isSampleData: boolean }
const { company, isSampleData } = Astro.props;
const title = `${company.nameJa}(${company.securityCode})の非公開化・MBO・TOB案件一覧`;
const description = `${company.nameJa}(証券コード${company.securityCode})の非公開化・MBO・TOB関連案件を企業単位で整理。過去案件と再燃を確認できます。`;
---
<Base title={title} description={description} path={`/companies/${company.securityCode}/`}>
  {isSampleData && <p class="notice">このページは開発・デモ用の<strong>架空のサンプルデータ</strong>です。</p>}
  <nav class="small" aria-label="パンくず" style="margin-bottom:0.8rem"><a href="/">案件一覧</a> › <span class="muted">{company.nameJa}</span></nav>
  <header class="case-head">
    <p class="case-head__company"><span class="mono">{company.securityCode}</span>{company.market && <span> / {company.market}</span>}{company.industry && <span> / {company.industry}</span>}</p>
    <h1>{company.nameJa}</h1>
    <p class="muted">この企業に紐づく全案件を時系列降順で表示します。案件が終息した後に再度観測が出る「再燃」も同じURLで確認できます。</p>
  </header>
  <section class="section">
    <h2 class="section-title">全案件一覧</h2>
    {company.cases.length === 0 ? <p class="empty-state">公開中の案件はありません。</p> : (
      <div class="table-wrap"><table class="case-table"><thead><tr><th>ステータス</th><th>案件</th><th>最初の観測報道</th><th>最終更新</th></tr></thead><tbody>
        {company.cases.map((c) => <tr><td><StatusBadge status={c.effectiveStatus} reportCount={c.reportCount} commentCount={c.commentCount} heatLevel={c.heatLevel} /></td><td><a class="case-link" href={`/cases/${c.slug}/`}>{c.title}</a><div class="small muted">{c.summary}</div></td><td>{formatDate(c.firstReportedAt)}</td><td>{formatDate(c.lastUpdatedAt)}</td></tr>)}
      </tbody></table></div>
    )}
  </section>
</Base>
