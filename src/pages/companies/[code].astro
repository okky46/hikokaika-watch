---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import QuickValuation from '../../components/QuickValuation.astro';
import {loadValuations} from '../../lib/valuationData';
import StockLinks from '../../components/StockLinks.astro';
import TrackingStatus from '../../components/TrackingStatus.astro';
import { loadPublicData } from '../../lib/publicData';
import { formatDate } from '../../lib/format';
import type { PublicCompany } from '../../lib/types';
import {valuationCompanies} from '../../lib/valuationCompanies';

export async function getStaticPaths() {
  const data = await loadPublicData();
  const {financials}=await loadValuations();
  return valuationCompanies(data.companies,financials).map((company) => ({ params: { code: company.securityCode }, props: { company, isSampleData: data.isSampleData, articles:data.articles.filter(a=>a.companies.some(c=>c.id===company.id)) } }));
}

interface Props { articles: import('../../lib/articles').PublicArticle[]; company: PublicCompany; isSampleData: boolean }
const { company, isSampleData } = Astro.props;
const valuations=await loadValuations();
const title = `${company.nameJa}(${company.securityCode})の非公開化・MBO・TOB案件一覧`;
const description = `${company.nameJa}（証券コード${company.securityCode}）の非公開化・MBO・TOBに関する経過をまとめています。過去の案件や、再び動きがあった案件を確認できます。`;
---
<Base title={title} description={description} path={`/companies/${company.securityCode}/`}>
  {isSampleData && <p class="notice">このページは開発・デモ用の<strong>架空のサンプルデータ</strong>です。</p>}
  <nav class="small" aria-label="パンくず" style="margin-bottom:0.8rem"><a href="/">追跡銘柄</a> › <span class="muted">{company.nameJa}</span></nav>
  <header class="case-head">
    <p class="case-head__company"><span class="mono">{company.securityCode}</span>{company.market && <span> / {company.market}</span>}{company.industry && <span> / {company.industry}</span>}</p>
    <h1>{company.nameJa}</h1>
    <p class="muted">この企業の案件と関連記事をまとめています。案件名を選ぶと、現在の状況や詳しい経過を確認できます。</p>
  </header>
  <section class="section">
    <h2 class="section-title">この企業の案件</h2>
    {company.cases.length === 0 ? <p class="empty-state">この企業の追跡記録はまだ掲載していません。</p> : (
      <div class="company-cases">
        {company.cases.map((c) => <article class="card company-case">
          <h3><a class="research-title" href={`/cases/${c.slug}/`}><span>{c.companyName}の状況・経過を見る{company.cases.length>1 && `：${c.title}`}</span><span aria-hidden="true">→</span></a></h3>
          <div class="company-case__status"><TrackingStatus profile={c.tracking} /></div>
          <p>{c.summary}</p>
          <dl class="company-case__dates"><div><dt>日付を確認できた最初の報道</dt><dd>{c.firstReportedAt ? formatDate(c.firstReportedAt) : '未確認'}</dd></div><div><dt>最終更新</dt><dd>{formatDate(c.lastUpdatedAt)}</dd></div></dl>
        </article>)}
      </div>
    )}
  </section>
<StockLinks code={company.securityCode}/><section class="section"><h2 class="section-title">関連記事</h2><ArticleList articles={Astro.props.articles}/></section>
<QuickValuation financials={valuations.financials.find(f=>f.code===company.securityCode)} industry={company.industry}/>
</Base>
