---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** canonical 用のパス(例: /cases/0001-xxx/)。省略時は現在のURL */
  path?: string;
  /** 検索エンジンに登録させないページ(マイページ・管理画面) */
  noindex?: boolean;
  /** Whether this page renders one or more configured AdSense slots. */
  hasAdSlots?: boolean;
}

const { title, description, path, noindex = false, hasAdSlots = false } = Astro.props;

const site = Astro.site ?? new URL('https://hikokaika-watch.pages.dev');
const canonical = new URL(path ?? Astro.url.pathname, site).href;
const formUrl = import.meta.env.PUBLIC_REQUEST_FORM_URL ?? '';
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN ?? '';
const SITE_NAME = '非公開化ウォッチ';
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!noindex && <link rel="sitemap" href="/sitemap.xml" />}
    {hasAdSlots && import.meta.env.PUBLIC_ADSENSE_CLIENT && !import.meta.env.DEV && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href="/">非公開化ウォッチ</a>
        <span class="site-header__tag">非公開化・MBO・TOB 観測報道アーカイブ</span>
        <nav class="site-nav" aria-label="サイト内メニュー">
          <a href="/">案件一覧</a>
          <a href="/guidelines/">掲載基準・FAQ</a>
          <a href="/disclaimer/">免責事項</a>
          <a href="/mypage/">マイページ</a>
          {formUrl && (
            <a class="is-cta" href={formUrl} target="_blank" rel="noopener noreferrer">
              追加・訂正申請
            </a>
          )}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <nav class="site-footer__nav" aria-label="フッターメニュー">
          <a href="/">案件一覧</a>
          <a href="/guidelines/">掲載基準・FAQ</a>
          <a href="/disclaimer/">免責事項</a>
          <a href="/privacy/">プライバシーポリシー</a>
          <a href="/mypage/">マイページ</a>
          {formUrl && (
            <a href={formUrl} target="_blank" rel="noopener noreferrer">追加掲載・訂正の申請(Googleフォーム)</a>
          )}
        </nav>
        <p class="site-footer__note">
          非公開化ウォッチは、一般に公開された報道・適時開示・会社発表および株価情報を時系列で整理する情報データベースです。
          特定の有価証券の取得・売却・保有その他の投資判断を推奨または助言するものではありません。
        </p>
        <p class="site-footer__note">
          株価情報は管理者が公開情報をもとに手動登録した参考値であり、リアルタイム情報ではありません。
        </p>
        <p class="site-footer__note">© 非公開化ウォッチ</p>
      </div>
    </footer>
    {cfAnalyticsToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{\"token\": \"${cfAnalyticsToken}\"}`}></script>
    )}
  </body>
</html>
