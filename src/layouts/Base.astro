---
import '../styles/global.css';
import { ADMIN_CONTACT_URL } from '../lib/contact';

interface Props {
  title: string;
  description: string;
  /** canonical 用のパス(例: /cases/0001-xxx/)。省略時は現在のURL */
  path?: string;
  /** 検索エンジンに登録させないページ(マイページ・管理画面) */
  noindex?: boolean;
  /** Whether this page renders one or more configured AdSense slots. */
  hasAdSlots?: boolean;
}

const { title, description, path, noindex: requestedNoindex = false, hasAdSlots = false } = Astro.props;
const noindex = requestedNoindex || import.meta.env.DEPLOY_ENV !== 'production';

const site = Astro.site ?? new URL('https://hikokaika.com');
const canonical = new URL(path ?? Astro.url.pathname, site).href;
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN ?? '';
const SITE_NAME = '非公開化ウォッチ';
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navigation = [
  { href: '/', label: '追跡銘柄', active: currentPath === '/' || /^\/(cases|companies)\//.test(currentPath) },
  { href: '/articles/', label: '調査記事', active: currentPath === '/articles' || currentPath.startsWith('/articles/') },
  { href: '/guidelines/', label: '掲載基準・FAQ', active: currentPath === '/guidelines' },
  { href: '/disclaimer/', label: '免責事項', active: currentPath === '/disclaimer' },
  { href: '/mypage/', label: 'マイページ', active: currentPath === '/mypage' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!noindex && <link rel="sitemap" href="/sitemap.xml" />}
    {hasAdSlots && import.meta.env.PUBLIC_ADSENSE_CLIENT && !import.meta.env.DEV && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href="/">非公開化ウォッチ</a>
        <span class="site-header__tag">非公開化の噂とその後を追う</span>
        <nav class="site-nav" aria-label="サイト内メニュー">
          {navigation.map(item => <a href={item.href} aria-current={item.active ? (currentPath === (item.href.replace(/\/$/, '') || '/') ? 'page' : 'location') : undefined}>{item.label}</a>)}
          <a class="is-cta" href={ADMIN_CONTACT_URL} target="_blank" rel="noopener noreferrer">追加・訂正（XのDM）</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <nav class="site-footer__nav" aria-label="フッターメニュー">
          <a href="/">追跡銘柄</a>
          <a href="/articles/">調査記事</a>
          <a href="/guidelines/">掲載基準・FAQ</a>
          <a href="/disclaimer/">免責事項</a>
          <a href="/privacy/">プライバシーポリシー</a>
          <a href="/mypage/">マイページ</a>
          <a href={ADMIN_CONTACT_URL} target="_blank" rel="noopener noreferrer">追加掲載・訂正はXのDMへ</a>
        </nav>
        <p class="site-footer__note">
          掲載情報は、非公開化の実現を保証しません。売買を推奨するものでもありません。
        </p>
        <p class="site-footer__note">© 非公開化ウォッチ</p>
      </div>
    </footer>
    {cfAnalyticsToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{\"token\": \"${cfAnalyticsToken}\"}`}></script>
    )}
  </body>
</html>
